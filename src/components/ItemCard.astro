---
import type { Category } from "../../scripts/extract/config";
import type { Entry, Localized } from "../../scripts/extract/schemas";
import { catalogLabel } from "../lib/catalog";
import type { Lang } from "../lib/i18n";
import { compareLang, htmlLang, lowerFor } from "../lib/lang";
import EntryIcon from "./EntryIcon.astro";
import TooltipPanel from "./TooltipPanel.astro";

interface Props {
  lang: Lang;
  href: string;
  name: Localized;
  icon?: string;
  category: Category;
  variant: Entry["variant"];
  kicker: string;
  description?: Localized;
  /** Position in the list; staggers the cascade-in animation and gives the specimen its number. */
  index?: number;
}

const { lang, href, name, icon, category, variant, kicker, description, index = 0 } = Astro.props;
const unique = variant === "unique";
const alt = compareLang(lang);
---
<li class="entry-card" style={`--i:${index}`} data-variant={variant} data-names={[lang, alt].map((l) => lowerFor(name[l], lang)).join(" ")}>
  <a class="item-link" href={href}>
    <span class="card-no" aria-hidden="true">{catalogLabel(index + 1)}</span>
    <span class="card-art"><EntryIcon icon={icon} alt={name[lang]} size={72} category={category} variant={variant} /></span>
    <span class="card-names">
      <span class:list={["primary", "item-name", { "is-unique": unique }]}>{name[lang]}</span>
      {name[alt] !== name[lang] && <span class="item-alt" lang={htmlLang(alt)}>{name[alt]}</span>}
    </span>
  </a>
  <template class="item-tip">
    <TooltipPanel lang={lang} kicker={kicker} name={name} description={description} unique={unique}>
      <slot />
    </TooltipPanel>
  </template>
</li>
