---
import { t, type Lang } from "../lib/i18n";
import LangPicker from "./LangPicker.astro";
import SiteMenu from "./SiteMenu.astro";
import { href } from "../lib/url";

interface Props {
  lang: Lang;
  /** Links the language menu to each language's home page (for pages without a same-path counterpart, like the 404). */
  langMenuToHome?: boolean;
}

const { lang, langMenuToHome = false } = Astro.props;
---
<header class="site-header">
  <a class="brand" href={href(lang)}>
    <span class="brand-mark" aria-hidden="true">MCD2</span>
    <span class="brand-full">{t(lang, "siteTitle")}</span><span class="brand-short">{t(lang, "siteShort")}</span>
  </a>
  <button type="button" class="search-toggle" aria-expanded="false" aria-controls="header-search">{t(lang, "search")}</button>
  <form id="header-search" class="header-search" action={href(lang, "search")} method="get" role="search" aria-label={t(lang, "siteSearch")}>
    <input type="search" name="q" placeholder={t(lang, "searchPlaceholder")} aria-label={t(lang, "search")} />
  </form>
  <div class="site-tools">
    <button type="button" class="compare-toggle" aria-pressed="true" data-testid="compare-toggle">
      <span class="label-long">{t(lang, "compare")}</span><span class="label-short">{t(lang, "compareShort")}</span>
    </button>
    <LangPicker lang={lang} toHome={langMenuToHome} />
    <SiteMenu lang={lang} />
  </div>
</header>
<script>
  import { withCurrentLocation } from "../lib/lang-switch";

  const STORAGE_KEY = "mcd2-compare";
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>(".compare-toggle");
  const syncCompare = () => button?.setAttribute("aria-pressed", String(root.dataset.compare !== "off"));
  syncCompare();
  button?.addEventListener("click", () => {
    const next = root.dataset.compare === "off" ? "on" : "off";
    root.dataset.compare = next;
    try {
      localStorage.setItem(STORAGE_KEY, next);
    } catch {
      // Storage unavailable: the choice lasts for this page view only.
    }
    syncCompare();
  });

  // Every language link keeps the current page's query and anchor, also when the map page rewrites them.
  const langLinks = [...document.querySelectorAll<HTMLAnchorElement>(".lang-picker a")];
  const picker = document.querySelector<HTMLDetailsElement>(".lang-picker");
  const bases = langLinks.map((link) => link.getAttribute("href") ?? "");
  const syncLang = () =>
    langLinks.forEach((link, index) => link.setAttribute("href", withCurrentLocation(bases[index] ?? "", location.search, location.hash)));
  if (picker && picker.dataset.home !== "true") {
    syncLang();
    window.addEventListener("hashchange", syncLang);
    // The map page rewrites its query and hash with history.replaceState, which fires no event of its own.
    window.addEventListener("mcd2:locationchange", syncLang);
  }
  for (const link of langLinks) {
    link.addEventListener("click", () => {
      try {
        localStorage.setItem("mcd2-lang", link.dataset.lang ?? "");
      } catch {
        // Storage unavailable: the choice applies to this navigation only.
      }
    });
  }
  // The language menu and the site menu: Esc or an outside click closes them, and opening one closes the other.
  const headerMenus = [...document.querySelectorAll<HTMLDetailsElement>(".site-header details.header-menu")];
  for (const menu of headerMenus) {
    menu.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !menu.open) return;
      menu.open = false;
      menu.querySelector("summary")?.focus();
    });
    menu.addEventListener("toggle", () => {
      if (!menu.open) return;
      for (const other of headerMenus) if (other !== menu) other.open = false;
    });
  }
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node)) return;
    const target = event.target;
    for (const menu of headerMenus) if (menu.open && !menu.contains(target)) menu.open = false;
  });

  // Narrow screens fold the header search behind a button (see layout.css).
  const searchToggle = document.querySelector<HTMLButtonElement>(".search-toggle");
  const searchForm = document.querySelector<HTMLFormElement>(".header-search");
  const setSearchOpen = (open: boolean) => {
    searchForm?.classList.toggle("is-open", open);
    searchToggle?.setAttribute("aria-expanded", String(open));
  };
  searchToggle?.addEventListener("click", () => {
    const open = searchToggle.getAttribute("aria-expanded") !== "true";
    setSearchOpen(open);
    if (open) searchForm?.querySelector("input")?.focus();
  });
  searchForm?.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || searchToggle?.offsetParent === null) return;
    setSearchOpen(false);
    searchToggle?.focus();
  });
</script>
