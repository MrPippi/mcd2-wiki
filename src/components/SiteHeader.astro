---
import { t, type Lang } from "../lib/i18n";
import LangPicker from "./LangPicker.astro";
import SiteMenu from "./SiteMenu.astro";
import { href } from "../lib/url";

interface Props {
  lang: Lang;
  /** Links the language menu to each language's home page (for pages without a same-path counterpart, like the 404). */
  langMenuToHome?: boolean;
}

const { lang, langMenuToHome = false } = Astro.props;
---
<header class="site-header">
  <a class="brand" href={href(lang)}>
    <span class="brand-mark" aria-hidden="true">MCD2</span>
    <span class="brand-full">{t(lang, "siteTitle")}</span><span class="brand-short">{t(lang, "siteShort")}</span>
  </a>
  <button type="button" class="search-toggle" aria-expanded="false" aria-controls="header-search">{t(lang, "search")}</button>
  <form id="header-search" class="header-search" action={href(lang, "search")} method="get" role="search" aria-label={t(lang, "siteSearch")}>
    <input type="search" name="q" placeholder={t(lang, "searchPlaceholder")} aria-label={t(lang, "search")} />
  </form>
  <div class="site-tools">
    <button type="button" class="compare-toggle" aria-pressed="true" data-testid="compare-toggle">
      <span class="label-long">{t(lang, "compare")}</span><span class="label-short">{t(lang, "compareShort")}</span>
    </button>
    <LangPicker lang={lang} toHome={langMenuToHome} />
    <SiteMenu lang={lang} />
  </div>
</header>
<script>
  import { mountSiteHeader } from "../client/site-header";

  mountSiteHeader(document);
</script>
