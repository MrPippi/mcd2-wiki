---
import { HTML_LANG, otherLang, t, type Lang } from "../lib/i18n";
import { href, swapLangPath } from "../lib/url";

interface Props {
  lang: Lang;
  /** Overrides the language switch target for pages without a same-path counterpart. */
  switchHref?: string;
}

const { lang, switchHref: override } = Astro.props;
const alt = otherLang(lang);
const switchHref = override ?? swapLangPath(Astro.url.pathname, import.meta.env.BASE_URL, alt);
---
<header class="site-header">
  <a class="brand" href={href(lang)}>
    <span class="brand-mark" aria-hidden="true">MCD2</span>
    <span class="brand-full">{t(lang, "siteTitle")}</span><span class="brand-short">{t(lang, "siteShort")}</span>
  </a>
  <button type="button" class="search-toggle" aria-expanded="false" aria-controls="header-search">{t(lang, "search")}</button>
  <form id="header-search" class="header-search" action={href(lang, "search")} method="get" role="search">
    <input type="search" name="q" placeholder={t(lang, "searchPlaceholder")} aria-label={t(lang, "search")} />
  </form>
  <div class="site-tools">
    <button type="button" class="compare-toggle" aria-pressed="true" data-testid="compare-toggle">
      <span class="label-long">{t(lang, "compare")}</span><span class="label-short">{t(lang, "compareShort")}</span>
    </button>
    <a class="lang-switch button" href={switchHref} hreflang={HTML_LANG[alt]} data-testid="lang-switch">
      <span class="label-long">{t(lang, "switchLang")}</span><span class="label-short">{t(lang, "switchLangShort")}</span>
    </a>
  </div>
</header>
<script>
  import { withCurrentLocation } from "../lib/lang-switch";

  const STORAGE_KEY = "mcd2-compare";
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>(".compare-toggle");
  const syncCompare = () => button?.setAttribute("aria-pressed", String(root.dataset.compare !== "off"));
  syncCompare();
  button?.addEventListener("click", () => {
    const next = root.dataset.compare === "off" ? "on" : "off";
    root.dataset.compare = next;
    try {
      localStorage.setItem(STORAGE_KEY, next);
    } catch {
      // Storage unavailable: the choice lasts for this page view only.
    }
    syncCompare();
  });

  const langLink = document.querySelector<HTMLAnchorElement>("[data-testid='lang-switch']");
  const langBase = langLink?.getAttribute("href") ?? "";
  const syncLang = () => langLink?.setAttribute("href", withCurrentLocation(langBase, location.search, location.hash));
  syncLang();
  window.addEventListener("hashchange", syncLang);

  // Narrow screens fold the header search behind a button (see layout.css).
  const searchToggle = document.querySelector<HTMLButtonElement>(".search-toggle");
  const searchForm = document.querySelector<HTMLFormElement>(".header-search");
  const setSearchOpen = (open: boolean) => {
    searchForm?.classList.toggle("is-open", open);
    searchToggle?.setAttribute("aria-expanded", String(open));
  };
  searchToggle?.addEventListener("click", () => {
    const open = searchToggle.getAttribute("aria-expanded") !== "true";
    setSearchOpen(open);
    if (open) searchForm?.querySelector("input")?.focus();
  });
  searchForm?.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || searchToggle?.offsetParent === null) return;
    setSearchOpen(false);
    searchToggle?.focus();
  });
</script>
