---
import { t, type Lang } from "../lib/i18n";
import { clockJson } from "../lib/soul-storm";
import type { ClockPayload } from "../lib/soul-storm-schedule";

interface Props {
  lang: Lang;
  payload: ClockPayload;
}

const { lang, payload } = Astro.props;
---
{/* Starts hidden: without JavaScript the static cadence line and rotation list stand in for it (spec D5). */}
<div class="soul-storm-clock" data-testid="soul-storm-clock" data-soul-storm-clock hidden>
  <div class="soul-storm-now">
    <p class="soul-storm-status" data-testid="soul-storm-status" data-status aria-live="polite"></p>
    <p class="soul-storm-countdown" data-testid="soul-storm-countdown" data-countdown></p>
  </div>
  <h3 class="soul-storm-subtitle">{t(lang, "soulStormUpcoming")}</h3>
  <div class="soul-storm-scroll" tabindex="0" role="region" aria-label={t(lang, "soulStormUpcoming")}>
    <table class="soul-storm-table soul-storm-upcoming" data-testid="soul-storm-upcoming">
      <thead>
        <tr>
          <th scope="col">{t(lang, "soulStormColStart")}</th>
          <th scope="col">{t(lang, "soulStormColArea")}</th>
        </tr>
      </thead>
      <tbody data-upcoming></tbody>
    </table>
  </div>
  <p class="note soul-storm-timezone" data-testid="soul-storm-timezone" data-timezone></p>
  <script type="application/json" data-soul-storm-json set:html={clockJson(payload)}></script>
</div>

<script>
  import { mountSoulStormClock } from "../client/soul-storm-clock";

  const root = document.querySelector<HTMLElement>("[data-soul-storm-clock]");
  if (root) mountSoulStormClock(root);
</script>
