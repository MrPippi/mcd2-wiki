---
import type { Category } from "../../shared/config";
import { catalogLabel, categoryCount } from "../lib/catalog";
import { categoryLabel, t, type Lang } from "../lib/i18n";
import { TAB_ORDER } from "../../shared/tabs";
import { categoryIcon } from "../lib/ui-icons";
import { href } from "../lib/url";
import UiIcon from "./UiIcon.astro";

interface Props {
  lang: Lang;
  current?: Category;
}

const { lang, current } = Astro.props;
---
<nav class="site-nav category-tabs" aria-label={t(lang, "categories")} data-current={current}>
  <ol class="tab-list">
    {TAB_ORDER.map((category, index) => (
      <li>
        <a href={href(lang, category)} data-category={category} aria-current={category === current ? "page" : undefined}>
          <span class="tab-index" aria-hidden="true">{catalogLabel(index + 1).slice(1)}</span>
          <UiIcon src={categoryIcon(category)} />
          <span class="tab-label">{categoryLabel(category, lang)}</span>
          <span class="tab-count" aria-hidden="true">{categoryCount(category)}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>
<script>
  import { mountCategoryTabs } from "../client/category-tabs";

  mountCategoryTabs(document);
</script>
