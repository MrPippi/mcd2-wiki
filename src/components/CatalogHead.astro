---
import { compareLang, htmlLang } from "../../shared/lang";
import type { Lang } from "../lib/i18n";
import UiIcon from "./UiIcon.astro";

interface Props {
  lang: Lang;
  /** The page title in a given language; the second-language line under the title is taken from the same function. */
  label: (lang: Lang) => string;
  /** The number printed above the title; omitted on pages that are not a numbered list. */
  count?: number;
  icon?: string;
  /** Show the second-language line even when it matches the title. */
  repeatAlt?: boolean;
  /** The lede under the title, and the class that styles it. */
  intro?: string;
  introClass?: string;
  /** Page-specific class next to `catalog-head`. */
  class?: string;
}

const { lang, label, count, icon, repeatAlt, intro, introClass, class: className } = Astro.props;
const alt = compareLang(lang);
---
<header class:list={["catalog-head", className]}>
  {count !== undefined && <p class="catalog-count kicker mono">{count}</p>}
  <h1 class="catalog-title">
    <UiIcon src={icon} />
    <span data-pagefind-meta="title">{label(lang)}</span>
  </h1>
  {(repeatAlt || label(alt) !== label(lang)) && <p class="catalog-alt item-alt" lang={htmlLang(alt)}>{label(alt)}</p>}
  {intro && <p class={introClass}>{intro}</p>}
  <slot />
</header>
