---
import type { Entry } from "../../scripts/extract/schemas";
import { t, type Lang } from "../lib/i18n";
import { areaHref, bookDroppers, dropperHref, entrySources, groupIsUntranslated, merchantCategoryLabel, nameIsUntranslated, showsAltName } from "../lib/item-source-view";
import type { ResolvedSource } from "../lib/item-sources";
import { compareLang, htmlLang } from "../lib/lang";
import { locationOf } from "../lib/locations";
import { dropSummary } from "../lib/mobs";
import { listParts, templateParts } from "../lib/quest-view";
import { questHref, rewardQuests } from "../lib/quests";
import { assetUrl } from "../lib/url";
import EntrySection from "./EntrySection.astro";

interface Props {
  lang: Lang;
  entry: Entry;
}

const { lang, entry } = Astro.props;
const sources = entrySources(entry);
const alt = compareLang(lang);
const picksText = (picks: { count: number; of: number }) => t(lang, "sourcePicksOf").replace("{count}", String(picks.count)).replace("{of}", String(picks.of));
const showAlt = (source: ResolvedSource) => showsAltName(source, lang);
// When a whole group fell back to English, one marker on its heading says so instead of one per row.
const groupTag = (group: readonly ResolvedSource[]) => groupIsUntranslated(group, lang);
const rowTag = (source: ResolvedSource, group: readonly ResolvedSource[]) => !groupTag(group) && nameIsUntranslated(source, lang);
const AREA_ICON_SIZE = 24;
// An area pool's location icon, when the area belongs to a location that has one.
const areaIcon = (source: ResolvedSource): string | undefined => {
  const icon = locationOf(source.id.replace(/^area:/, ""))?.icon;
  return icon ? assetUrl(icon) : undefined;
};
// A quest source the quest data ties to its quests reads "Reward of <quest>", each quest linked; otherwise the generic label stays.
const rewardOf = templateParts(t(lang, "sourceRewardOf"), "quest");
---
{sources && (
  <EntrySection title={t(lang, "itemSources")} testid="item-sources">
    <div class="item-sources" data-pagefind-ignore>
      {sources.areas.length > 0 && (
        <div class="source-group" data-source-kind="areas">
          <h3>{t(lang, "sourceAreas")} {groupTag(sources.areas) && <span class="tag warn">{t(lang, "untranslated")}</span>}</h3>
          <ul>
            {sources.areas.map((source) => (
              <li>
                <span class="source-area">
                  {areaIcon(source) && <img class="source-area-icon" src={areaIcon(source)} alt="" width={AREA_ICON_SIZE} height={AREA_ICON_SIZE} loading="lazy" decoding="async" />}
                  <a href={areaHref(lang, source.id, source.name)}>{source.name[lang]}</a>
                </span>
                {showAlt(source) && <span class="item-alt" lang={htmlLang(alt)}>{source.name[alt]}</span>}
                {rowTag(source, sources.areas) && <span class="tag warn">{t(lang, "untranslated")}</span>}
              </li>
            ))}
          </ul>
        </div>
      )}
      {sources.chests.length > 0 && (
        <div class="source-group" data-source-kind="chests">
          <h3>{t(lang, "sourceChests")} {groupTag(sources.chests) && <span class="tag warn">{t(lang, "untranslated")}</span>}</h3>
          <ul>
            {sources.chests.map((source) => (
              <li>
                <span class="source-name">{source.name[lang]}</span>
                {showAlt(source) && <span class="item-alt" lang={htmlLang(alt)}>{source.name[alt]}</span>}
                <span class="tag" data-testid={source.pool === "fixed" ? "chest-fixed" : "chest-area"}>
                  {t(lang, source.pool === "fixed" ? "sourceChestFixed" : "sourceChestArea")}
                </span>
                {rowTag(source, sources.chests) && <span class="tag warn">{t(lang, "untranslated")}</span>}
              </li>
            ))}
          </ul>
        </div>
      )}
      {sources.quests.length > 0 && (
        <div class="source-group" data-source-kind="quests">
          <h3>{t(lang, "sourceQuests")} {groupTag(sources.quests) && <span class="tag warn">{t(lang, "untranslated")}</span>}</h3>
          <ul>
            {sources.quests.map((source) => {
              const givers = rewardQuests(source.id);
              return (
              <li>
                {givers.length > 0 ? (
                  <span class="source-reward-of" data-testid="source-reward-of">
                    {rewardOf.map((part) => part.kind === "text" ? part.text : listParts(htmlLang(lang), givers.length).map((piece) =>
                      piece.kind === "text" ? piece.text : <a href={questHref(lang, givers[piece.index].slug)}>{givers[piece.index].title.text[lang]}</a>))}
                  </span>
                ) : <span class="source-name">{source.name[lang]}</span>}
                {givers.length === 0 && showAlt(source) && <span class="item-alt" lang={htmlLang(alt)}>{source.name[alt]}</span>}
                {source.picks
                  ? <span class="tag" data-testid="picks">{picksText(source.picks)}</span>
                  : <span class="tag" data-testid="guaranteed">{t(lang, "sourceGuaranteed")}</span>}
                {rowTag(source, sources.quests) && <span class="tag warn">{t(lang, "untranslated")}</span>}
              </li>
              );
            })}
          </ul>
        </div>
      )}
      {sources.merchants.length > 0 && (
        <div class="source-group" data-source-kind="merchants">
          <h3>{t(lang, "sourceMerchants")} {groupTag(sources.merchants) && <span class="tag warn">{t(lang, "untranslated")}</span>}</h3>
          <ul>
            {sources.merchants.map((source) => (
              <li>
                <span class="source-name">{source.name[lang]}</span>
                {showAlt(source) && <span class="item-alt" lang={htmlLang(alt)}>{source.name[alt]}</span>}
                <span class="tag" data-testid="merchant-category">{t(lang, "sourceMerchantCategory").replace("{category}", merchantCategoryLabel(source.category, lang))}</span>
                {rowTag(source, sources.merchants) && <span class="tag warn">{t(lang, "untranslated")}</span>}
              </li>
            ))}
          </ul>
        </div>
      )}
      {sources.bookPools.length > 0 && (
        <div class="source-group" data-source-kind="book-pools">
          <h3>{t(lang, "sourceBookPools")} {groupTag(sources.bookPools) && <span class="tag warn">{t(lang, "untranslated")}</span>}</h3>
          <ul>
            {sources.bookPools.map((source) => (
              <li>
                <span class="source-name">{source.name[lang]}</span>
                {showAlt(source) && <span class="item-alt" lang={htmlLang(alt)}>{source.name[alt]}</span>}
                {rowTag(source, sources.bookPools) && <span class="tag warn">{t(lang, "untranslated")}</span>}
              </li>
            ))}
          </ul>
        </div>
      )}
      {sources.bookPools.length > 0 && bookDroppers.length > 0 && (
        <div class="source-group" data-source-kind="book-drops">
          <h3>{t(lang, "sourceBookDroppers")} {groupTag(bookDroppers) && <span class="tag warn">{t(lang, "untranslated")}</span>}</h3>
          <ul>
            {bookDroppers.map((source) => {
              const href = dropperHref(lang, source);
              return (
              <li>
                {href ? <a href={href}>{source.name[lang]}</a> : <span class="source-name">{source.name[lang]}</span>}
                {showAlt(source) && <span class="item-alt" lang={htmlLang(alt)}>{source.name[alt]}</span>}
                {dropSummary({ ...source, slot: "enchantedBook", pool: "area" }, lang).map((line) => <span class="tag" data-testid="book-drop-rule">{line}</span>)}
                {rowTag(source, bookDroppers) && <span class="tag warn">{t(lang, "untranslated")}</span>}
              </li>
              );
            })}
          </ul>
        </div>
      )}
      <p class="note">{t(lang, "sourcesNote")}</p>
    </div>
  </EntrySection>
)}
