---
import type { Entry } from "../../scripts/extract/schemas";
import { t, type Lang } from "../lib/i18n";
import { areaHref, entrySources, merchantCategoryLabel, nameIsUntranslated } from "../lib/item-source-view";
import type { ResolvedSource } from "../lib/item-sources";
import { compareLang, htmlLang } from "../lib/lang";
import EntrySection from "./EntrySection.astro";

interface Props {
  lang: Lang;
  entry: Entry;
}

const { lang, entry } = Astro.props;
const sources = entrySources(entry);
const alt = compareLang(lang);
const picksText = (picks: { count: number; of: number }) => t(lang, "sourcePicksOf").replace("{count}", String(picks.count)).replace("{of}", String(picks.of));
const showAlt = (source: ResolvedSource) => source.name[alt] !== source.name[lang];
---
{sources && (
  <EntrySection title={t(lang, "itemSources")} testid="item-sources">
    <div class="item-sources" data-pagefind-ignore>
      {sources.areas.length > 0 && (
        <div class="source-group" data-source-kind="areas">
          <h3>{t(lang, "sourceAreas")}</h3>
          <ul>
            {sources.areas.map((source) => (
              <li>
                <a href={areaHref(lang, source.id, source.name)}>{source.name[lang]}</a>
                {showAlt(source) && <span class="item-alt" lang={htmlLang(alt)}>{source.name[alt]}</span>}
                {nameIsUntranslated(source, lang) && <span class="tag warn">{t(lang, "untranslated")}</span>}
              </li>
            ))}
          </ul>
        </div>
      )}
      {sources.chests.length > 0 && (
        <div class="source-group" data-source-kind="chests">
          <h3>{t(lang, "sourceChests")}</h3>
          <ul>
            {sources.chests.map((source) => (
              <li>
                <span class="source-name">{source.name[lang]}</span>
                {showAlt(source) && <span class="item-alt" lang={htmlLang(alt)}>{source.name[alt]}</span>}
                <span class="tag" data-testid={source.pool === "fixed" ? "chest-fixed" : "chest-area"}>
                  {t(lang, source.pool === "fixed" ? "sourceChestFixed" : "sourceChestArea")}
                </span>
                {nameIsUntranslated(source, lang) && <span class="tag warn">{t(lang, "untranslated")}</span>}
              </li>
            ))}
          </ul>
        </div>
      )}
      {sources.quests.length > 0 && (
        <div class="source-group" data-source-kind="quests">
          <h3>{t(lang, "sourceQuests")}</h3>
          <ul>
            {sources.quests.map((source) => (
              <li>
                <span class="source-name">{source.name[lang]}</span>
                {showAlt(source) && <span class="item-alt" lang={htmlLang(alt)}>{source.name[alt]}</span>}
                {source.picks
                  ? <span class="tag" data-testid="picks">{picksText(source.picks)}</span>
                  : <span class="tag" data-testid="guaranteed">{t(lang, "sourceGuaranteed")}</span>}
                {nameIsUntranslated(source, lang) && <span class="tag warn">{t(lang, "untranslated")}</span>}
              </li>
            ))}
          </ul>
        </div>
      )}
      {sources.merchants.length > 0 && (
        <div class="source-group" data-source-kind="merchants">
          <h3>{t(lang, "sourceMerchants")}</h3>
          <ul>
            {sources.merchants.map((source) => (
              <li>
                <span class="source-name">{source.name[lang]}</span>
                {showAlt(source) && <span class="item-alt" lang={htmlLang(alt)}>{source.name[alt]}</span>}
                <span class="tag" data-testid="merchant-category">{t(lang, "sourceMerchantCategory").replace("{category}", merchantCategoryLabel(source.category, lang))}</span>
                {nameIsUntranslated(source, lang) && <span class="tag warn">{t(lang, "untranslated")}</span>}
              </li>
            ))}
          </ul>
        </div>
      )}
      {sources.bookPools.length > 0 && (
        <div class="source-group" data-source-kind="book-pools">
          <h3>{t(lang, "sourceBookPools")}</h3>
          <ul>
            {sources.bookPools.map((source) => (
              <li>
                <span class="source-name">{source.name[lang]}</span>
                {showAlt(source) && <span class="item-alt" lang={htmlLang(alt)}>{source.name[alt]}</span>}
                {nameIsUntranslated(source, lang) && <span class="tag warn">{t(lang, "untranslated")}</span>}
              </li>
            ))}
          </ul>
        </div>
      )}
      <p class="note">{t(lang, "sourcesNote")}</p>
    </div>
  </EntrySection>
)}
