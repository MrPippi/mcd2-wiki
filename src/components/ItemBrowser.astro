---
import { t, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---
<div class="item-browser">
  <ul class="entry-grid item-grid"><slot /></ul>
</div>
<div class="cursor-tooltip panel" id="item-tooltip" role="tooltip" data-testid="item-tooltip" hidden></div>
<div class="item-sheet panel" data-testid="item-sheet" role="dialog" aria-label={t(lang, "itemDetails")} tabindex="-1" hidden>
  <button type="button" class="sheet-close" aria-label={t(lang, "close")}>×</button>
  <div class="sheet-body"></div>
  <a class="sheet-view button" href="#">{t(lang, "view")} ›</a>
</div>
<script>
  import { mountItemBrowser } from "../client/item-browser";

  mountItemBrowser(document);
</script>
