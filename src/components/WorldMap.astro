---
import { MARKER_KINDS, type MapData, type WorldMap } from "../../shared/map-schema";
import { FILTER_KINDS } from "../../shared/map/kinds";
import { markerLabel, t, type Lang } from "../lib/i18n";
import { compareLang } from "../../shared/lang";
import { countByKind } from "../lib/map/markers";
import { trimWorld } from "../lib/map/payload";
import { overviewTile } from "../lib/map/tiles";
import { assetUrl } from "../lib/url";

interface Props {
  lang: Lang;
  worlds: readonly WorldMap[];
  legend: MapData["legend"];
}

const { lang, worlds, legend } = Astro.props;
const [first] = worlds;
const counts = first ? countByKind(first.markers) : undefined;
const labels = Object.fromEntries(MARKER_KINDS.map((kind) => [kind, markerLabel(kind, lang)]));
// Only the page language and its comparison language go to the browser (spec §2.6).
const shownLangs = [lang, compareLang(lang)];
// Escape "<" so no game text can close the script element early.
const notes = { storm: t(lang, "mapNoteStorm") };
const payload = JSON.stringify({ worlds: worlds.map((world) => trimWorld(world, shownLangs)), labels, notes }).replace(/</g, "\\u003c");
---
{first ? (
  <div class="world-map" data-lang={lang} data-world={first.key}>
    <nav class="map-tabs" aria-label={t(lang, "worldMap")}>
      <ol>
        {worlds.map((world) => (
          <li>
            <a href={`?world=${world.key}`} data-world={world.key} aria-current={world.key === first.key ? "page" : undefined}>
              {world.name[lang]}
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <div class="map-body">
      <div class="map-stage">
        <div class="map-canvas" data-map-canvas></div>
        <div class="map-fallback">
          <img src={assetUrl(overviewTile(first.key))} alt={first.name[lang]} width="256" height="256" />
          <p>{t(lang, "mapNeedsJs")}</p>
        </div>
        {/* On the map, top right; starts folded to its button on every screen so it never hides markers. */}
        <details class="map-filters" data-map-filters>
          <summary>{t(lang, "mapMarkers")}</summary>
          <ul role="list">
            {FILTER_KINDS.map((kind) => (
              <li>
                <button type="button" class="map-filter" data-kind={kind} aria-pressed="true">
                  {legend[kind] ? (
                    <img class="map-swatch-icon" src={assetUrl(legend[kind])} alt="" width="20" height="20" />
                  ) : (
                    <span class={`map-swatch map-swatch--${kind}`} aria-hidden="true" />
                  )}
                  <span class="map-filter-label">{markerLabel(kind, lang)}</span>
                  <span class="map-count mono" data-count={kind}>{counts?.[kind] ?? 0}</span>
                </button>
              </li>
            ))}
          </ul>
        </details>
      </div>
      <div class="map-panel">
        <div class="map-search">
          <label for="map-search">{t(lang, "mapSearch")}</label>
          <input id="map-search" type="search" data-testid="map-search" placeholder={t(lang, "mapSearchPlaceholder")} autocomplete="off" />
          <ul class="map-results" data-testid="map-results"></ul>
          <p class="map-empty" data-testid="map-empty" hidden>{t(lang, "mapNoResults")}</p>
        </div>
        <p class="map-note">{t(lang, "mapSource")}</p>
      </div>
    </div>
    <script type="application/json" data-map-json set:html={payload}></script>
  </div>
) : (
  <p class="map-no-data">{t(lang, "mapNoData")}</p>
)}

<script>
  import { mountWorldMap } from "../client/map-viewer";

  const root = document.querySelector<HTMLElement>(".world-map");
  if (root) mountWorldMap(root);
</script>
