---
import type { Entry } from "../../scripts/extract/schemas";
import { t, type Lang } from "../lib/i18n";
import { companionCooldown, talismanLevelsView } from "../lib/talisman-view";
import EntrySection from "./EntrySection.astro";

interface Props {
  lang: Lang;
  talisman: Entry;
}

const { lang, talisman } = Astro.props;
const rows = talismanLevelsView(lang, talisman);
const cooldown = companionCooldown(lang, talisman);
const hasValue = rows?.some((row) => row.value) ?? false;
const hasCompanion = rows?.some((row) => row.companion) ?? false;
---
{rows && (
  <EntrySection title={t(lang, "talismanLevels")} testid="talisman-levels">
    {cooldown && (
      <dl class="stat-grid" data-pagefind-ignore>
        <div>
          <dt>{t(lang, "statLabelCooldownSeconds")}</dt>
          <dd>{cooldown}</dd>
        </div>
      </dl>
    )}
    <table class="level-table" data-pagefind-ignore>
      <thead>
        <tr>
          <th scope="col">{t(lang, "talismanLevel")}</th>
          {hasValue && <th scope="col">{t(lang, "levelValue")}</th>}
          {hasCompanion && <th scope="col">{t(lang, "companionAttack")}</th>}
          {hasCompanion && <th scope="col">{t(lang, "companionDefence")}</th>}
          {hasCompanion && <th scope="col">{t(lang, "companionCooldown")}</th>}
          <th scope="col">{t(lang, "xpToNextLevel")}</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <th scope="row" class="level-label">{row.label}</th>
            {hasValue && <td class="num level-value" data-testid="level-value">{row.value}</td>}
            {hasCompanion && <td class="num">{row.companion?.attack}</td>}
            {hasCompanion && <td class="num">{row.companion?.defence}</td>}
            {hasCompanion && <td class="num">{row.companion?.cooldown}</td>}
            <td class="num">{row.xp}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="effect-source" data-pagefind-ignore>{t(lang, "talismanLevelsNote")}</p>
  </EntrySection>
)}
