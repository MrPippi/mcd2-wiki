---
import type { Entry } from "../../scripts/extract/schemas";
import { describedEntry, describedLong } from "../lib/gear-values";
import { t, type Lang } from "../lib/i18n";
import { itemKicker } from "../lib/kicker";
import { relatedLinks } from "../lib/related";
import { hasUnknownValues, isSecretTalisman } from "../lib/talisman-view";
import AffixOdds from "./AffixOdds.astro";
import DropOdds from "./DropOdds.astro";
import ArtifactStats from "./ArtifactStats.astro";
import BookSource from "./BookSource.astro";
import EnchantmentTiers from "./EnchantmentTiers.astro";
import EntryIcon from "./EntryIcon.astro";
import EntrySection from "./EntrySection.astro";
import ItemSources from "./ItemSources.astro";
import InfoBox from "./InfoBox.astro";
import LangText from "./LangText.astro";
import TalismanLevels from "./TalismanLevels.astro";
import FixedOn from "./FixedOn.astro";
import WeaponEffects from "./WeaponEffects.astro";
import WeaponStats from "./WeaponStats.astro";

interface Props {
  lang: Lang;
  entry: Entry;
}

const { lang, entry } = Astro.props;
const description = describedEntry(entry);
const descriptionLong = describedLong(entry);
const related = relatedLinks(lang, entry);
---
<article class="entry-detail" data-pagefind-body>
  <div class="entry-layout">
    <InfoBox lang={lang} entry={entry} />
    <div class="entry-content">
      <p class="kicker entry-kicker" data-pagefind-ignore>{itemKicker(entry.category, entry.variant)}</p>
      <LangText as="h1" lang={lang} value={entry.name} searchTitle class={entry.variant === "unique" ? "is-unique" : undefined} />
      {isSecretTalisman(entry) && (
        <p class="secret-badge"><span class="tag" data-testid="secret-talisman">{t(lang, "secretTalisman")}</span></p>
      )}
      {description && (
        <EntrySection title={t(lang, "description")}>
          <LangText as="p" class="description" lang={lang} value={description} html />
          {hasUnknownValues(entry) && <p class="note" data-testid="values-unknown" data-pagefind-ignore>{t(lang, "valuesNotInData")}</p>}
        </EntrySection>
      )}
      {descriptionLong && (
        <EntrySection title={t(lang, "details")}>
          <LangText as="p" class="description-long" lang={lang} value={descriptionLong} html />
        </EntrySection>
      )}
      {entry.unlock && (
        <EntrySection title={t(lang, "unlock")} testid="unlock">
          <LangText as="p" lang={lang} value={entry.unlock} html />
        </EntrySection>
      )}
      {entry.category === "enchantment" && <EnchantmentTiers lang={lang} enchantment={entry} />}
      {entry.category === "artifact" && <ArtifactStats lang={lang} artifact={entry} />}
      {entry.category === "talisman" && <TalismanLevels lang={lang} talisman={entry} />}
      <WeaponStats lang={lang} weapon={entry} />
      <WeaponEffects lang={lang} weapon={entry} />
      <AffixOdds lang={lang} item={entry} />
      {(entry.category === "enchantment" || entry.category === "effect") && <FixedOn lang={lang} entry={entry} />}
      {entry.category === "enchantment" && <BookSource lang={lang} enchantment={entry} />}
      <ItemSources lang={lang} entry={entry} />
      <DropOdds lang={lang} item={entry} />
      {related.length > 0 && (
        <EntrySection title={t(lang, "related")}>
          <ul class="related" data-pagefind-ignore>
            {related.map((link) => (
              <li>
                <span class="related-label" data-pagefind-ignore>{t(lang, link.labelKey)}</span>
                <a href={link.href}>
                  {link.icon && <EntryIcon icon={link.icon} alt="" size={40} category={link.category} variant={link.variant} />}
                  <LangText lang={lang} value={link.name} />
                </a>
              </li>
            ))}
          </ul>
        </EntrySection>
      )}
    </div>
  </div>
</article>
