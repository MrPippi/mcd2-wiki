---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { Category } from "../../scripts/extract/config";
import { allArmorSets, entriesIn, publishedEntries } from "../lib/data";
import { CATEGORY_LABEL, t, type Lang } from "../lib/i18n";
import { pickShowcase } from "../lib/showcase";
import { TAB_ORDER } from "../lib/tabs";
import { categoryIcon } from "../lib/ui-icons";
import { href } from "../lib/url";
import EntryIcon from "./EntryIcon.astro";
import UiIcon from "./UiIcon.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const countOf = (category: Category): number =>
  category === "armor" ? allArmorSets.length : entriesIn(category).length;
// Slot sizes for the collage, largest first; each item gets its own place in the home.css grid.
const SHOWCASE_SIZES = [152, 112, 128, 96, 104, 88] as const;
// The game name gets a line of its own, and "II" never wraps away from "Dungeons".
const GAME_NAME = "Minecraft Dungeons II";
const siteTitle = t(lang, "siteTitle");
const titleRest = siteTitle.startsWith(GAME_NAME) ? siteTitle.slice(GAME_NAME.length).trim() : undefined;
// The splash comes from the extract step; a glob keeps the build working when it has not been extracted.
const splashModules = import.meta.glob<{ default: ImageMetadata }>("../assets/brand/splash.png", { eager: true });
const splash = Object.values(splashModules)[0]?.default;
const showcase = pickShowcase(publishedEntries, ["melee", "ranged", "armor", "talisman", "artifact", "enchantment"])
  .slice(0, SHOWCASE_SIZES.length);
---
<section class="home-hero">
  {splash && (
    <div class="hero-backdrop" aria-hidden="true">
      <Image src={splash} alt="" widths={[960, 1600]} sizes="(min-width: 900px) 1180px, 100vw" format="webp" quality={68} loading="eager" fetchpriority="high" />
    </div>
  )}
  <div class="hero-copy">
    <p class="kicker">UNOFFICIAL FAN WIKI</p>
    <h1 class="home-title">
      {titleRest === undefined ? siteTitle : (
        <>
          <span class="title-game">{GAME_NAME.replace(" II", "\u00a0II")}</span>{" "}
          <span class="title-rest">{titleRest}</span>
        </>
      )}
    </h1>
    <p class="hero-lede">{t(lang, "tagline")}</p>
    <form class="home-search" action={href(lang, "search")} method="get" role="search">
      <input type="search" name="q" placeholder={t(lang, "searchPlaceholder")} aria-label={t(lang, "search")} />
      <button type="submit">{t(lang, "search")}</button>
    </form>
  </div>
  <div class="hero-showcase" aria-hidden="true">
    {showcase.map((entry, index) => (
      <span class={`showcase-item showcase-${index + 1}`} style={`--i:${index}`}>
        <EntryIcon icon={entry.icon} alt="" size={SHOWCASE_SIZES[index]} category={entry.category} variant={entry.variant} loading="eager" />
      </span>
    ))}
  </div>
</section>
<section class="home-categories" aria-labelledby="browse-title">
  <h2 class="section-title" id="browse-title"><span class="section-en">BROWSE</span><span>{t(lang, "browse")}</span></h2>
  <ul class="category-grid">
    {TAB_ORDER.map((category, index) => (
      <li style={`--i:${index}`}>
        <a href={href(lang, category)}>
          <span class="category-slot"><UiIcon src={categoryIcon(category)} /></span>
          <span class="category-name">{CATEGORY_LABEL[category][lang]}</span>
          <span class="count">{countOf(category)}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
