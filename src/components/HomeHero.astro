---
import type { Category } from "../../scripts/extract/config";
import { catalogLabel, categoryCount, entryNumber } from "../lib/catalog";
import { entriesIn, publishedEntries } from "../lib/data";
import { categoryLabel, t, type Lang } from "../lib/i18n";
import { compareLang, htmlLang } from "../lib/lang";
import { itemKicker } from "../lib/kicker";
import { pickShowcase } from "../lib/showcase";
import { splitSiteTitle } from "../lib/site-title";
import { TAB_ORDER } from "../lib/tabs";
import { categoryIcon } from "../lib/ui-icons";
import { entryHref, href } from "../lib/url";
import EntryIcon from "./EntryIcon.astro";
import LangText from "./LangText.astro";
import UiIcon from "./UiIcon.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const alt = compareLang(lang);
const siteTitle = t(lang, "siteTitle");
// The game name gets a line of its own, and "II" never wraps away from "Dungeons".
// A trailing qualifier such as "（简体）" is set small instead of at display size.
const titleParts = splitSiteTitle(siteTitle);
const FEATURED_SIZE = 240;
const SIDE_SPECIMENS = 4;
const PREVIEW_SPRITES = 6;
const [featured, ...others] = pickShowcase(publishedEntries, ["melee", "ranged", "armor", "talisman", "artifact", "enchantment"]);
const sideSpecimens = others.slice(0, SIDE_SPECIMENS);
const featuredNumber = featured ? entryNumber(featured) : undefined;
const PREVIEW_SIZE = 32;
const previewOf = (category: Category) => entriesIn(category).filter((entry) => entry.icon !== undefined).slice(0, PREVIEW_SPRITES);
---
<section class="home-hero">
  <div class="hero-copy">
    <p class="kicker">UNOFFICIAL FAN WIKI</p>
    <h1 class="home-title">
      {titleParts === undefined ? siteTitle : (
        <>
          <span class="title-game">{titleParts.game.replace(" II", " II")}</span>{" "}
          <span class="title-rest">{titleParts.word}{titleParts.tag && <span class="title-tag">{titleParts.tag}</span>}</span>
        </>
      )}
    </h1>
    <p class="hero-lede">{t(lang, "tagline")}</p>
    <form class="home-search" action={href(lang, "search")} method="get" role="search">
      <input type="search" name="q" placeholder={t(lang, "searchPlaceholder")} aria-label={t(lang, "search")} />
      <button type="submit">{t(lang, "search")}</button>
    </form>
  </div>
  {featured && (
    <figure class="hero-specimen">
      <a class="specimen-plate" href={entryHref(lang, featured)}>
        <span class="plate-no mono">{featuredNumber !== undefined ? `${t(lang, "catalogNo")} ${catalogLabel(featuredNumber)}` : ""}</span>
        <span class="plate-art">
          <EntryIcon icon={featured.icon} alt={featured.name[lang]} size={FEATURED_SIZE} category={featured.category} variant={featured.variant} loading="eager" />
        </span>
        <span class="plate-scale" aria-hidden="true"></span>
      </a>
      <figcaption class="specimen-caption">
        <span class="caption-kicker">{itemKicker(featured.category, featured.variant)}</span>
        <LangText lang={lang} value={featured.name} class={featured.variant === "unique" ? "caption-name is-unique" : "caption-name"} />
      </figcaption>
      <ul class="side-specimens" aria-label={t(lang, "browse")}>
        {sideSpecimens.map((entry, index) => (
          <li style={`--i:${index}`}>
            <a href={entryHref(lang, entry)} title={entry.name[lang]}>
              <EntryIcon icon={entry.icon} alt={entry.name[lang]} size={56} category={entry.category} variant={entry.variant} loading="eager" />
            </a>
          </li>
        ))}
      </ul>
    </figure>
  )}
</section>
<section class="home-categories" aria-labelledby="browse-title">
  <h2 class="section-title" id="browse-title">{t(lang, "browse")}</h2>
  <ul class="category-grid">
    {TAB_ORDER.map((category, index) => (
      <li style={`--i:${index}`}>
        <a href={href(lang, category)}>
          <span class="category-index mono" aria-hidden="true">{catalogLabel(index + 1).slice(1)}</span>
          <span class="category-slot"><UiIcon src={categoryIcon(category)} /></span>
          <span class="category-name">{categoryLabel(category, lang)}</span>
          <span class="category-alt item-alt" lang={htmlLang(alt)}>{categoryLabel(category, alt)}</span>
          <span class="category-preview" aria-hidden="true">
            {previewOf(category).map((entry) => (
              <EntryIcon icon={entry.icon} alt="" size={PREVIEW_SIZE} category={entry.category} variant={entry.variant} />
            ))}
          </span>
          <span class="count">{categoryCount(category)}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
