---
import type { Mob } from "../../shared/mob-schema";
import { statLabel, t, type Lang } from "../lib/i18n";
import { RAW_UNIT_STATS, formatStat } from "../lib/mobs";

interface Props {
  lang: Lang;
  stats: Mob["stats"];
  /** h2 for the page's own stats, h3 inside the Soul Corrupted section. */
  level?: 2 | 3;
  /** Test id of the section, so the Soul Corrupted stats can be told apart from the page's own. */
  testid?: string;
}

const { lang, stats, level = 2, testid = "mob-stats" } = Astro.props;
const Heading = level === 3 ? "h3" : "h2";
---
{stats.length > 0 && (
  <section class="entry-section mob-stats" data-testid={testid}>
    <Heading class="section-title" data-pagefind-ignore>{t(lang, "mobStats")}</Heading>
    <table class="mob-stat-table">
      <tbody>
        {stats.map((stat) => (
          <tr>
            <th scope="row">{statLabel(stat.key, lang)}</th>
            <td>{formatStat(stat.key, stat.value)}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="note">{t(lang, "mobBaseValues")}</p>
    {stats.some((stat) => RAW_UNIT_STATS.has(stat.key)) && <p class="note">{t(lang, "mobUnitsNote")}</p>}
  </section>
)}
