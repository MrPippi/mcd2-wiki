---
import { t, type Lang } from "../lib/i18n";
import { SITE_MENU, isMenuPage } from "../../shared/sections";
import { href } from "../lib/url";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const items = SITE_MENU.map((item) => ({
  label: t(lang, item.key),
  href: href(lang, item.segment),
  current: isMenuPage(Astro.url.pathname, import.meta.env.BASE_URL, item.segment),
}));
---
<details class="site-menu header-menu">
  <summary data-testid="site-menu" aria-label={t(lang, "siteMenu")}>
    <svg class="menu-icon" aria-hidden="true" viewBox="0 0 14 12" width="14" height="12"><path d="M0 1h14M0 6h14M0 11h14" /></svg>
  </summary>
  <ul aria-label={t(lang, "siteMenu")}>
    {items.map((item) => (
      <li>
        <a href={item.href} aria-current={item.current ? "page" : undefined}>{item.label}</a>
      </li>
    ))}
  </ul>
</details>
