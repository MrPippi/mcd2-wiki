---
import type { Chest, SoulStormData } from "../../scripts/extract/soul-storm-schema";
import { lootSlotLabel, t, type Lang, type UiKey } from "../lib/i18n";
import { dropSummary } from "../lib/mobs";
import { chestLabel, chestsOf, rarityLine, slotRows, textOf } from "../lib/soul-storm";

interface Props {
  lang: Lang;
  data: SoulStormData;
}

const { lang, data } = Astro.props;
const GROUP_TITLE = { generator: "soulStormChestsGenerator", final: "soulStormChestsFinal" } as const satisfies Record<Chest["group"], UiKey>;
const groups = (["generator", "final"] as const).map((group) => ({ group, chests: chestsOf(data, group) })).filter((entry) => entry.chests.length > 0);
const extra = textOf(data, "extraEffect", lang);
// The rarity row's tag is the parent of both chest groups, so its sentence follows both of them.
const rarity = rarityLine(data, lang);
type Slot = Chest["slots"][number];
const slotOf = (chest: Chest, key: Slot["slot"]): Slot | undefined => chest.slots.find((slot) => slot.slot === key);
// Gear slots name no item list in the data: said once per row, never as a guess at the items.
const hasNoList = (chests: readonly Chest[], key: Slot["slot"]): boolean => chests.some((chest) => slotOf(chest, key)?.pool === "none");
---
{groups.length > 0 && (
  <section class="entry-section soul-storm-chests" data-testid="soul-storm-chests">
    <div class="soul-storm-heading">
      <h2 class="section-title" data-pagefind-ignore>{t(lang, "soulStormChests")}</h2>
    </div>
    {groups.map(({ group, chests }) => (
      <div class="soul-storm-chest-group">
        <div class="soul-storm-heading">
          <h3 class="soul-storm-subtitle">{t(lang, GROUP_TITLE[group])}</h3>
          <span class="tag soul-storm-unconfirmed" data-testid="soul-storm-unconfirmed">{t(lang, "soulStormTierUnconfirmed")}</span>
        </div>
        <div class="soul-storm-scroll" tabindex="0" role="region" aria-label={t(lang, GROUP_TITLE[group])}>
          <table class="soul-storm-table soul-storm-chest-table">
            <thead>
              <tr>
                <td></td>
                {chests.map((chest) => <th scope="col">{chestLabel(chest, lang)}</th>)}
              </tr>
            </thead>
            <tbody>
              {slotRows(chests).map((key) => (
                <tr>
                  <th scope="row">
                    {lootSlotLabel(key, lang)}
                    {hasNoList(chests, key) && <span class="soul-storm-cell-note">{t(lang, "mobDropPoolNone")}</span>}
                  </th>
                  {chests.map((chest) => {
                    const slot = slotOf(chest, key);
                    return <td>{slot ? dropSummary(slot, lang).map((line) => <span class="soul-storm-line">{line}</span>) : "—"}</td>;
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ))}
    {rarity && <p class="note soul-storm-rarity" data-testid="soul-storm-rarity">{rarity}</p>}
    {extra && (
      <p class="soul-storm-text soul-storm-extra">
        <span set:html={extra.html} />
        {extra.untranslated && <span class="tag warn">{t(lang, "untranslated")}</span>}
      </p>
    )}
  </section>
)}
