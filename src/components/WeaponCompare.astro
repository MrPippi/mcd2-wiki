---
import ItemPickerDialog from "./ItemPickerDialog.astro";
import { comparePayloadJson } from "../lib/compare/payload";
import { MAX_WEAPONS } from "../lib/compare/code";
import type { ComparePayload } from "../lib/compare/parse";
import { t, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
  payload: ComparePayload;
}

const { lang, payload } = Astro.props;
---
{/* Starts hidden: the page script shows it once the payload checks out; without scripts the page's noscript note stands in. */}
<div class="compare" data-testid="weapon-compare" data-weapon-compare hidden>
  <p class="compare-notice tag warn" data-testid="compare-notice" data-notice role="status" hidden></p>
  {/* One button adds a weapon; each compared weapon shows once, in the table head, with its own remove button. */}
  <div class="compare-toolbar">
    <button type="button" class="compare-add" data-testid="compare-add" data-add aria-haspopup="dialog">
      <span class="compare-add-mark" aria-hidden="true">+</span>
      <span>{payload.labels.add}</span>
      <span class="compare-count" data-count>{`0 / ${MAX_WEAPONS}`}</span>
    </button>
  </div>
  <p class="note compare-empty" data-testid="compare-empty" data-empty>{payload.labels.empty}</p>
  <div class="compare-scroll" tabindex="0" role="region" aria-label={t(lang, "weaponCompare")} data-scroll hidden>
    <table class="compare-table" data-testid="compare-table" data-table>
      <thead data-head></thead>
      <tbody data-body></tbody>
    </table>
  </div>
  <div class="compare-actions">
    <button type="button" data-testid="compare-copy" data-copy>{t(lang, "buildCopyLink")}</button>
    <p class="note compare-status" data-testid="compare-status" data-status role="status" aria-live="polite"></p>
  </div>
  <input class="compare-url" type="text" data-testid="compare-url" data-url readonly aria-label={t(lang, "buildLink")} hidden />
  <ItemPickerDialog prefix="compare" close={payload.labels.close} filter={payload.labels.filter} noResults={payload.labels.noResults} />
  <script type="application/json" data-weapon-compare-json set:html={comparePayloadJson(payload)}></script>
</div>
<p class="note" data-testid="compare-failed" data-weapon-compare-failed hidden>{t(lang, "weaponCompareLoadFailed")}</p>

<script>
  import { mountCompare } from "../client/compare";

  const root = document.querySelector<HTMLElement>("[data-weapon-compare]");
  if (root && !mountCompare(root)) {
    console.error("weapon compare: bad payload or markup");
    document.querySelector<HTMLElement>("[data-weapon-compare-failed]")?.removeAttribute("hidden");
  }
</script>
