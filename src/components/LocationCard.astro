---
import type { Location } from "../../scripts/extract/location-schema";
import { t, type Lang } from "../lib/i18n";
import { compareLang, htmlLang, searchNames } from "../lib/lang";
import { formatLevels } from "../lib/location-view";
import { countsOf, locationHref } from "../lib/locations";
import LocationIcon from "./LocationIcon.astro";

interface Props {
  lang: Lang;
  location: Location;
  /** Position in the whole list; staggers the cascade-in animation. */
  index: number;
}

const { lang, location, index } = Astro.props;
const alt = compareLang(lang);
const counts = countsOf(location);
const CARD_ICON_SIZE = 56;
const facts = [
  { key: "locationCountMobs" as const, value: counts.mobs, testid: "count-mobs" },
  { key: "locationCountBosses" as const, value: counts.bosses, testid: "count-bosses" },
  { key: "quests" as const, value: counts.quests, testid: "count-quests" },
];
---
<li class="location-card" style={`--i:${index}`} data-testid="location-card" data-names={searchNames(location.name, lang)}>
  <a class="location-card-link" href={locationHref(lang, location.slug)}>
    <span class="location-card-head">
      <LocationIcon location={location} size={CARD_ICON_SIZE} />
      <span class="location-card-names">
        <span class="primary location-card-name">{location.name[lang]}</span>
        {location.name[alt] !== location.name[lang] && <span class="item-alt location-card-alt" lang={htmlLang(alt)}>{location.name[alt]}</span>}
        {location.untranslated.includes(lang) && <span class="tag warn">{t(lang, "untranslated")}</span>}
      </span>
    </span>
    {location.levels.length > 0 && (
      <span class="location-card-level" data-testid="location-card-level">{t(lang, "locationLevel")} <span class="mono">{formatLevels(location.levels)}</span></span>
    )}
    <span class="location-card-counts">
      {facts.map((fact) => (
        <span data-testid={fact.testid}>{t(lang, fact.key)} <span class="mono">{fact.value}</span></span>
      ))}
    </span>
  </a>
</li>
