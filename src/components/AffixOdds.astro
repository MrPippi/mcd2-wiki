---
import type { Entry } from "../../shared/schemas";
import { affixViewOf } from "../lib/affix-view";
import { guidesData } from "../lib/guides";
import { t, type Lang } from "../lib/i18n";
import { entryHref } from "../lib/url";
import EntryIcon from "./EntryIcon.astro";
import EntrySection from "./EntrySection.astro";
import GuideUnconfirmed from "./GuideUnconfirmed.astro";
import LangText from "./LangText.astro";

interface Props {
  lang: Lang;
  item: Entry;
}

const TIERS = ["I", "II", "III"] as const;
const EFFECT_ICON = 32;

const { lang, item } = Astro.props;
const view = affixViewOf(item);
const first = view?.rarities[0];
---
{view && first && (
  <EntrySection title={t(lang, "affixOddsTitle")} testid="affix-odds">
    <div data-affix={view.slug}>
      <p class="note" data-pagefind-ignore>{t(lang, "affixOddsIntro")}</p>
      <GuideUnconfirmed lang={lang} message="affixOddsUnconfirmed" verified={guidesData.verified.affixOdds} />
      {/* Starts hidden: the page script shows it; without scripts the table keeps its default threat and rarity. */}
      <div class="affix-controls" role="group" aria-label={t(lang, "affixControls")} data-testid="affix-controls" data-affix-controls hidden>
        <label>
          <span>{t(lang, "affixThreat")}</span>
          <select data-affix-level>
            {view.levels.map((level) => <option value={level} selected={level === view.level}>{level}</option>)}
          </select>
        </label>
        {view.rarities.length > 1 && (
          <label>
            <span>{t(lang, "rarity")}</span>
            <select data-affix-rarity>
              {view.rarities.map((one) => <option value={one.rarity} selected={one.rarity === view.rarity}>{t(lang, one.label)}</option>)}
            </select>
          </label>
        )}
        {view.rarities.some((one) => one.bonusSlots > 0) && (
          <label class="affix-bonus">
            <input type="checkbox" data-affix-bonus />
            <span>{t(lang, "affixBonus")}</span>
          </label>
        )}
      </div>
      <p class="affix-summary" data-testid="affix-summary" role="status" aria-live="polite" data-pagefind-ignore>
        <span>{t(lang, "affixThreat")} <b data-affix-level-text>{view.level}</b></span>
        <span data-affix-rarity-text>{t(lang, first.label)}</span>
        <span>{t(lang, "affixSlots")} <b data-affix-slots-text>{first.slots}</b></span>
      </p>
      {/* The table scrolls inside its own region on narrow screens; the page never does. */}
      <div class="table-scroll" tabindex="0" role="region" aria-label={t(lang, "affixOddsTitle")} data-pagefind-ignore>
      <table class="affix-table" data-testid="affix-table">
        <thead>
          <tr>
            <th scope="col">{t(lang, "effect")}</th>
            {TIERS.map((tier) => <th scope="col" class="tier">{tier}</th>)}
            <th scope="col" class="tier">{t(lang, "affixAnyTier")}</th>
          </tr>
        </thead>
        <tbody>
          {view.rows.map((row) => (
            <tr data-effect={row.effect.slug} class:list={{ "affix-fixed": row.fixed }}>
              <th scope="row" class:list={{ "has-icon": row.effect.icon }}>
                {row.effect.icon && <EntryIcon icon={row.effect.icon} alt="" size={EFFECT_ICON} />}
                {row.linked ? (
                  <a class="effect-name" href={entryHref(lang, row.effect)}><LangText lang={lang} value={row.effect.name} /></a>
                ) : (
                  <span class="effect-name"><LangText lang={lang} value={row.effect.name} /></span>
                )}
                {row.fixed && <span class="tag">{t(lang, "affixBuiltIn")}</span>}
              </th>
              {TIERS.map((tier, index) => <td class="tier-value" data-tier={tier} data-cell={index + 1}>{row.tiers[index]}</td>)}
              <td class="tier-value affix-any" data-tier={t(lang, "affixAnyTier")} data-cell="any">{row.any}</td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
    </div>
  </EntrySection>
)}
<script>
  import { mountAffixOdds } from "../client/affix-odds";

  const root = document.querySelector<HTMLElement>("[data-affix]");
  if (root) mountAffixOdds(root, () => import("../data/affix-models.json"));
</script>
