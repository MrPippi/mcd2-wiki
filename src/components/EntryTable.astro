---
import type { Entry } from "../../scripts/extract/schemas";
import { t, type Lang } from "../lib/i18n";
import EntryIcon from "./EntryIcon.astro";
import LangText from "./LangText.astro";

interface Props {
  lang: Lang;
  entries: readonly Entry[];
}

const { lang, entries } = Astro.props;
---
<table class="entry-table" data-pagefind-body>
  <thead>
    <tr><th>{t(lang, "name")}</th><th>{t(lang, "description")}</th></tr>
  </thead>
  <tbody>
    {entries.map((entry) => (
      <tr data-variant={entry.variant} data-names={`${entry.name.zh} ${entry.name.en}`.toLowerCase()}>
        <th scope="row">
          <div class="row-head">
            {entry.icon && <EntryIcon icon={entry.icon} alt={entry.name[lang]} size={40} category={entry.category} />}
            <LangText as="h3" id={entry.slug} class="row-name" lang={lang} value={entry.name} />
          </div>
        </th>
        <td>{entry.description ? <LangText lang={lang} value={entry.description} html /> : "—"}</td>
      </tr>
    ))}
  </tbody>
</table>
