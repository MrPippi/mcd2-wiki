---
import type { Entry } from "../../shared/schemas";
import { describedEntry } from "../lib/gear-values";
import { t, type Lang } from "../lib/i18n";
import { searchNames } from "../../shared/lang";
import EntryIcon from "./EntryIcon.astro";
import LangText from "./LangText.astro";

interface Props {
  lang: Lang;
  entries: readonly Entry[];
}

const { lang, entries } = Astro.props;
---
<table class="entry-table" data-pagefind-body>
  <thead>
    <tr><th>{t(lang, "name")}</th><th>{t(lang, "description")}</th></tr>
  </thead>
  <tbody>
    {entries.map((entry) => (
      <tr data-variant={entry.variant} data-names={searchNames(entry.name, lang)}>
        <th scope="row">
          <div class="row-head">
            {entry.icon && <EntryIcon icon={entry.icon} alt="" size={32} category={entry.category} variant={entry.variant} />}
            <LangText as="h2" id={entry.slug} class="row-name" lang={lang} value={entry.name} />
          </div>
        </th>
        <td>{describedEntry(entry) ? <LangText lang={lang} value={describedEntry(entry)!} html /> : <span class="empty-cell">-</span>}</td>
      </tr>
    ))}
  </tbody>
</table>
