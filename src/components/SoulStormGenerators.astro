---
import type { SoulStormData } from "../../scripts/extract/soul-storm-schema";
import { statLabel, t, type Lang } from "../lib/i18n";
import { formatChance, formatStat, mobHref } from "../lib/mobs";
import { anyUntranslated, formatMultipliers, generatorTierLabel, sharedMultipliers, summonedMobs, textOf } from "../lib/soul-storm";
import { assetUrl } from "../lib/url";

interface Props {
  lang: Lang;
  data: SoulStormData;
}

const { lang, data } = Astro.props;
const { generators } = data;
const name = textOf(data, "generatorName", lang);
const hints = [textOf(data, "generatorHint", lang), textOf(data, "shieldHint", lang)].flatMap((text) => text ?? []);
const untranslated = anyUntranslated(data, ["generatorName", "generatorHint", "shieldHint"], lang);
const shared = sharedMultipliers(generators);
const shieldText = (shield: SoulStormData["generators"][number]["shield"]): string =>
  shield
    ? t(lang, "soulStormShieldRule").replace("{chance}", formatChance(shield.chance, lang)).replace("{seconds}", String(shield.cooldownSeconds))
    : t(lang, "soulStormShieldNone");
const ICON_SIZE = 48;
---
{generators.length > 0 && (
  <section class="entry-section soul-storm-generators" data-testid="soul-storm-generators">
    <div class="soul-storm-heading">
      {data.icons.generator && <img class="soul-storm-icon" src={assetUrl(data.icons.generator)} alt="" width={ICON_SIZE} height={ICON_SIZE} loading="lazy" />}
      <h2 class="section-title" data-pagefind-ignore>{name ? <Fragment set:html={name.html} /> : t(lang, "soulStormTier")}</h2>
      {untranslated && <span class="tag warn">{t(lang, "untranslated")}</span>}
    </div>
    {hints.map((hint) => <p class="soul-storm-text" set:html={hint.html} />)}
    <div class="soul-storm-scroll">
      <table class="soul-storm-table soul-storm-generator-table">
        <thead>
          <tr>
            <th scope="col">{t(lang, "soulStormTier")}</th>
            {generators.map((generator) => <th scope="col">{generatorTierLabel(generator.tier, lang)}</th>)}
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">{t(lang, "statHealth")}</th>
            {generators.map((generator) => (
              <td>
                {generator.health}
                {!shared && <span class="soul-storm-cell-note">{t(lang, "soulStormHealthByPlayers").replace("{list}", formatMultipliers(generator.healthByPlayers))}</span>}
              </td>
            ))}
          </tr>
          <tr>
            <th scope="row">{t(lang, "soulStormSpawnWeight")}</th>
            {generators.map((generator) => <td>{generator.spawnWeight}</td>)}
          </tr>
          <tr>
            <th scope="row">{t(lang, "soulStormShield")}</th>
            {generators.map((generator) => <td>{shieldText(generator.shield)}</td>)}
          </tr>
        </tbody>
      </table>
    </div>
    {shared && <p class="note">{t(lang, "soulStormHealthByPlayers").replace("{list}", formatMultipliers(shared))}</p>}
    <dl class="soul-storm-summons">
      {generators.map((generator) => (
        <div class="soul-storm-summon">
          <dt>{generatorTierLabel(generator.tier, lang)}</dt>
          <dd>
            {t(lang, "soulStormFinalSummon").replace("{percent}", formatChance(generator.finalSummon.healthFraction, lang))}
            <ul class="soul-storm-mob-links">
              {summonedMobs(generator.finalSummon.mobs).map((mob) => <li><a href={mobHref(lang, mob.slug)}>{mob.name[lang]}</a></li>)}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
    {data.resistances.length > 0 && (
      <>
        <p class="soul-storm-text">{t(lang, "soulStormResistances")}</p>
        <table class="mob-stat-table soul-storm-resistances">
          <tbody>
            {data.resistances.map((stat) => (
              <tr>
                <th scope="row">{statLabel(stat.key, lang)}</th>
                <td>{formatStat(stat.key, stat.value)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )}
  </section>
)}
