---
import "@fontsource/silkscreen/400.css";
import "@fontsource/silkscreen/700.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/frames.css";
import "../styles/layout.css";
import "../styles/home.css";
import "../styles/items.css";
import "../styles/entry.css";
import "../styles/search.css";
import type { Category } from "../../scripts/extract/config";
import CategoryTabs from "../components/CategoryTabs.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { HTML_LANG, t, type Lang } from "../lib/i18n";
import { extractedBrand } from "../lib/data";
import { metaDescription } from "../lib/meta";
import { assetUrl } from "../lib/url";

interface Props {
  lang: Lang;
  title: string;
  /** The category this page belongs to; highlights its tab. */
  current?: Category;
  /** Plain-text page summary for search engines and link previews; defaults to the site tagline. */
  description?: string;
  /** Where the language switch leads when the page has no counterpart at the same path (the 404 page). */
  langSwitchHref?: string;
}

const OG_LOCALE: Readonly<Record<Lang, string>> = { zh: "zh_TW", en: "en_US" };

const { lang, title, current, description = "", langSwitchHref } = Astro.props;
const fullTitle = `${title} | ${t(lang, "siteTitle")}`;
const summary = metaDescription(description, 160, t(lang, "tagline"));
// Game icons from the extract step; the hand-drawn SVG covers a checkout without extracted art.
const favicon = extractedBrand.favicon
  ? { href: assetUrl(extractedBrand.favicon), type: "image/png" }
  : { href: assetUrl("favicon.svg"), type: "image/svg+xml" };
const appIcon = extractedBrand["app-icon"] ? assetUrl(extractedBrand["app-icon"]) : undefined;
// Link previews need an absolute URL, which needs the deployed site address (SITE_URL at build time).
const socialImage = extractedBrand.social && Astro.site ? new URL(assetUrl(extractedBrand.social), Astro.site).href : undefined;
---
<!doctype html>
<html lang={HTML_LANG[lang]} data-compare="on">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={summary} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t(lang, "siteTitle")} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={summary} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:width" content="480" />}
    {socialImage && <meta property="og:image:height" content="480" />}
    {socialImage && <meta property="og:image:alt" content="Minecraft Dungeons II" />}
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#1c2b31" />
    <link rel="icon" type={favicon.type} href={favicon.href} />
    {appIcon && <link rel="apple-touch-icon" href={appIcon} />}
    <script is:inline>
      (function () {
        document.documentElement.classList.add("js");
        try {
          if (localStorage.getItem("mcd2-compare") === "off") document.documentElement.dataset.compare = "off";
        } catch (error) {
          // Storage unavailable (private mode or blocked): keep the default "on".
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, "skipToContent")}</a>
    <SiteHeader lang={lang} switchHref={langSwitchHref} />
    <CategoryTabs lang={lang} current={current} />
    <main class="site-main" id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p>{t(lang, "disclaimer")}</p>
        <p>{t(lang, "source")}</p>
        <p class="footer-license"><a href={assetUrl("licenses/Cubic-11-OFL.txt")}>{t(lang, "fontLicense")}</a></p>
      </div>
    </footer>
  </body>
</html>
