---
import "@fontsource/noto-serif/700.css";
import "@fontsource/noto-serif-tc/700.css";
import "@fontsource/noto-serif-sc/700.css";
import "@fontsource/noto-serif-jp/700.css";
import "@fontsource/noto-serif-kr/700.css";
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/frames.css";
import "../styles/layout.css";
import "../styles/home.css";
import "../styles/items.css";
import "../styles/entry.css";
import "../styles/search.css";
import { ALL_LANGS, LANG_META, type Category } from "../../shared/config";
import CategoryTabs from "../components/CategoryTabs.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { t, type Lang } from "../lib/i18n";
import { splitSiteTitle } from "../lib/site-title";
import { htmlLang } from "../../shared/lang";
import { extractedBrand } from "../lib/data";
import { breadcrumbTrail } from "../lib/breadcrumbs";
import { absoluteUrl, breadcrumbLd, pageSummary, serializeJsonLd, websiteLd } from "../lib/seo";
import { assetUrl, href, swapLangPath } from "../lib/url";

interface Props {
  lang: Lang;
  title: string;
  /** The category this page belongs to; highlights its tab. */
  current?: Category;
  /** Plain-text page summary for search engines and link previews; defaults to the site tagline. */
  description?: string;
  /** Pages without a same-path counterpart in every language (the 404 page) link the menu to each language home and skip hreflang. */
  noAlternates?: boolean;
  /** A language home: the title is the site name alone and the page describes the whole site. */
  home?: boolean;
  /** Keeps the page out of search results (search results, the 404 page). */
  noindex?: boolean;
  /** Open Graph type; guides are articles. */
  ogType?: "website" | "article";
  /** Extra schema.org objects for this page, beside the breadcrumb trail. */
  structuredData?: readonly unknown[];
}


/** The issue form picker: data errors, in-game tests, translations, site bugs. */
const REPORT_URL = "https://github.com/MrPippi/mcd2-wiki/issues/new/choose";
/** Cloudflare Web Analytics site token (public, cookie-free); set by the deploy workflow so local builds send nothing. */
const analyticsToken = import.meta.env.CF_BEACON_TOKEN;

const { lang, title, current, description = "", noAlternates = false, home = false, noindex = false, ogType = "website", structuredData = [] } = Astro.props;
const siteTitle = t(lang, "siteTitle");
const footerTitle = splitSiteTitle(siteTitle);
const fullTitle = home ? siteTitle : `${title} | ${siteTitle}`;
const summary = pageSummary({ description, title, tagline: t(lang, "tagline"), home });
// Game icons from the extract step; the hand-drawn SVG covers a checkout without extracted art.
const favicon = extractedBrand.favicon
  ? { href: assetUrl(extractedBrand.favicon), type: "image/png" }
  : { href: assetUrl("favicon.svg"), type: "image/svg+xml" };
const appIcon = extractedBrand["app-icon"] ? assetUrl(extractedBrand["app-icon"]) : undefined;
// Every language version of this page, plus the root that picks one; absolute when the site address is known.
const absolute = (path: string): string => absoluteUrl(path, Astro.site);
const alternates = noAlternates
  ? []
  : ALL_LANGS.map((code) => ({ code, href: absolute(swapLangPath(Astro.url.pathname, import.meta.env.BASE_URL, code)) }));
const rootHref = absolute(assetUrl(""));
// Link previews need an absolute URL, which needs the deployed site address (SITE_URL at build time).
const canonical = absolute(Astro.url.pathname);
const crumbs = breadcrumbTrail(Astro.url.pathname, import.meta.env.BASE_URL, lang, title).map((crumb) => ({ name: crumb.name, url: absolute(crumb.href) }));
const jsonLd = [
  ...(home ? [websiteLd({ name: siteTitle, url: canonical, lang: htmlLang(lang), description: summary, searchUrl: absolute(href(lang, "search")) })] : []),
  ...(crumbs.length > 1 ? [breadcrumbLd(crumbs)] : []),
  ...structuredData,
];
const socialImage = extractedBrand.social && Astro.site ? new URL(assetUrl(extractedBrand.social), Astro.site).href : undefined;
---
<!doctype html>
<html lang={htmlLang(lang)} data-compare="on" data-base={assetUrl("")}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={summary} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t(lang, "siteTitle")} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={summary} />
    <meta property="og:locale" content={LANG_META[lang].ogLocale} />
    {ALL_LANGS.filter((code) => code !== lang).map((code) => (
      <meta property="og:locale:alternate" content={LANG_META[code].ogLocale} />
    ))}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:width" content="480" />}
    {socialImage && <meta property="og:image:height" content="480" />}
    {socialImage && <meta property="og:image:alt" content="Minecraft Dungeons II" />}
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#f3f4f1" />
    {alternates.map((alt) => <link rel="alternate" hreflang={LANG_META[alt.code].htmlLang} href={alt.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={rootHref} />}
    {jsonLd.map((data) => <script type="application/ld+json" set:html={serializeJsonLd(data)} />)}
    <link rel="icon" type={favicon.type} href={favicon.href} />
    {appIcon && <link rel="apple-touch-icon" href={appIcon} />}
    <script is:inline>
      (function () {
        document.documentElement.classList.add("js");
        try {
          if (localStorage.getItem("mcd2-compare") === "off") document.documentElement.dataset.compare = "off";
        } catch (error) {
          // Storage unavailable (private mode or blocked): keep the default "on".
        }
      })();
    </script>
    {analyticsToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: analyticsToken })}></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, "skipToContent")}</a>
    <SiteHeader lang={lang} langMenuToHome={noAlternates} />
    <CategoryTabs lang={lang} current={current} />
    <main class="site-main" id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-mark">{footerTitle === undefined ? siteTitle : (<><span class="mark-game">{footerTitle.game}</span>{" "}<span class="mark-rest">{footerTitle.word}</span>{footerTitle.tag && <>{" "}<span class="mark-tag">{footerTitle.tag}</span></>}</>)}</p>
        <div class="footer-meta">
          <p>{t(lang, "disclaimer")}</p>
          <p>{t(lang, "source")}</p>
          <p><a class="footer-report" href={REPORT_URL}>{t(lang, "reportIssue")}</a> · <a class="footer-report" href={href(lang, "changelog")} data-testid="footer-changelog">{t(lang, "changelog")}</a></p>
        </div>
        <p class="footer-license">{t(lang, "fontCredit")}</p>
      </div>
    </footer>
  </body>
</html>
