---
import { langPaths } from "../../lib/lang-paths";
import AchievementCard from "../../components/AchievementCard.astro";
import CatalogPage from "../../layouts/CatalogPage.astro";
import { achievementData, achievementsByRate, formatRetrieved, untranslatedMarkers } from "../../lib/achievements";
import { t, type Lang } from "../../lib/i18n";
import "../../styles/achievements.css";

export const getStaticPaths = langPaths;

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const achievements = achievementsByRate(achievementData.achievements);
const markers = untranslatedMarkers(achievements, lang);
const credit = t(lang, "achievementsCredit").replace("{date}", formatRetrieved(achievementData.retrieved, lang));
---
<CatalogPage lang={lang} label={(l) => t(l, "achievements")} count={achievements.length} intro={t(lang, "achievementsIntro")} introClass="achievements-intro" class="achievements-page" headClass="achievements-head">
    {markers.page && <span slot="head" class="tag warn achievements-untranslated">{t(lang, "untranslated")}</span>}
    <ol class="achievement-grid" data-pagefind-body>
      {achievements.map((achievement, index) => (
        <AchievementCard lang={lang} achievement={achievement} index={index} markUntranslated={markers.cards.has(achievement.id)} />
      ))}
    </ol>
    <p class="achievements-credit">{credit}</p>
</CatalogPage>
