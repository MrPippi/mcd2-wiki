---
import { langPaths } from "../../../lib/lang-paths";
import CatalogPage from "../../../layouts/CatalogPage.astro";
import { catalogLabel } from "../../../lib/catalog";
import { GUIDES } from "../../../lib/guides";
import { t, type Lang } from "../../../lib/i18n";
import { href } from "../../../lib/url";
import "../../../styles/guides.css";

export const getStaticPaths = langPaths;

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---
<CatalogPage lang={lang} label={(l) => t(l, "guides")} count={GUIDES.length} intro={t(lang, "guidesIntro")} introClass="guide-lede" class="guide-page guides-hub" headClass="guide-head" pagefindBody>
    <ol class="guide-cards">
      {GUIDES.map((guide, index) => (
        <li class="guide-card" style={`--i:${index}`} data-testid="guide-card">
          <a class="guide-card-link" href={href(lang, "guides", guide.slug)}>
            <span class="card-no" aria-hidden="true">{catalogLabel(index + 1)}</span>
            <span class="guide-card-title">{t(lang, guide.title)}</span>
            <span class="guide-card-summary">{t(lang, guide.summary)}</span>
          </a>
        </li>
      ))}
    </ol>
</CatalogPage>
