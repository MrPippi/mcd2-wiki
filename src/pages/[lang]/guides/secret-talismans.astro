---
import { LANGS } from "../../../../shared/config";
import type { GuidesData } from "../../../../shared/guides-schema";
import EntryIcon from "../../../components/EntryIcon.astro";
import GuideMarker from "../../../components/GuideMarker.astro";
import GuidePage from "../../../components/GuidePage.astro";
import GuideText from "../../../components/GuideText.astro";
import { catalogLabel } from "../../../lib/catalog";
import { findEntry } from "../../../lib/data";
import { fill, guideBySlug, guidesData, shown, type GuideLink } from "../../../lib/guides";
import { t, type Lang } from "../../../lib/i18n";
import { compareLang, htmlLang } from "../../../../shared/lang";
import { entryHref } from "../../../lib/url";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Lang;
  /** Injected by the component tests; the page itself always shows the extracted data. */
  data?: GuidesData;
}

const { lang } = Astro.props;
const data = Astro.props.data ?? guidesData;
const guide = guideBySlug("secret-talismans") as GuideLink;
const alt = compareLang(lang);
const ICON_SIZE = 72;
const secret = data.secretTalismans;
const talismans = secret.talismans.flatMap((talisman) => {
  const entry = findEntry("talisman", talisman.slug);
  return entry ? [{ talisman, entry }] : [];
});
const questName = (quest: GuidesData["secretTalismans"]["talismans"][number]["quests"][number]) => {
  const name = shown(quest.name, lang);
  return name ? name.html : fill(t(lang, "guideQuestUnnamed"), { id: quest.id });
};
const questNames = talismans.flatMap(({ talisman }) => talisman.quests.map((quest) => shown(quest.name, lang)));
/** The intro says every talisman sits in its own chest: only true when the data has a chest for each. */
const allInChests = talismans.length > 0 && talismans.every(({ talisman }) => talisman.chest);
const completion = [shown(secret.completion, lang), shown(secret.door, lang)];
---
<GuidePage lang={lang} guide={guide}>
  <section class="entry-section guide-section" data-testid="guide-secret-talismans">
    {allInChests && <p class="guide-text" data-testid="guide-secret-intro">{t(lang, "guideSecretIntro")}</p>}
    <GuideMarker lang={lang} texts={questNames} />
    <ul class="item-grid guide-talismans">
      {talismans.map(({ talisman, entry }, index) => (
        <li class="entry-card guide-talisman" style={`--i:${index}`} data-testid="guide-talisman">
          <a class="item-link" href={entryHref(lang, entry)}>
            <span class="card-no" aria-hidden="true">{catalogLabel(index + 1)}</span>
            <span class="card-art"><EntryIcon icon={entry.icon} alt={entry.name[lang]} size={ICON_SIZE} category="talisman" variant={entry.variant} /></span>
            <span class="card-names">
              <span class="primary item-name">{entry.name[lang]}</span>
              {entry.name[alt] !== entry.name[lang] && <span class="item-alt" lang={htmlLang(alt)}>{entry.name[alt]}</span>}
            </span>
          </a>
          <div class="guide-talisman-sources">
            {talisman.chest && <span class="guide-chip" data-testid="guide-talisman-chest">{t(lang, "guideSecretChest")}</span>}
            {talisman.quests.length > 0 && (
              <p class="guide-talisman-quests" data-testid="guide-talisman-quests">
                {t(lang, "guideSecretQuest")}
                {talisman.quests.map((quest) => <span class="guide-quest" set:html={questName(quest)} />)}
              </p>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>
  {completion.some((text) => text !== undefined) && (
    <section class="entry-section guide-section" data-testid="guide-secret-complete">
      <h2 class="section-title">{t(lang, "guideSecretComplete")}</h2>
      {completion.map((text) => <GuideText lang={lang} text={text} />)}
    </section>
  )}
</GuidePage>
