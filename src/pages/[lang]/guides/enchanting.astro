---
import { langPaths } from "../../../lib/lang-paths";
import type { GuidesData } from "../../../../shared/guides-schema";
import GuideHeading from "../../../components/GuideHeading.astro";
import GuideMarker from "../../../components/GuideMarker.astro";
import GuidePage from "../../../components/GuidePage.astro";
import GuideText from "../../../components/GuideText.astro";
import GuideUnconfirmed from "../../../components/GuideUnconfirmed.astro";
import { fill, formatNumber, guideBySlug, guidesData, rarityName, textOf, unlockText, type GuideLink } from "../../../lib/guides";
import { t, type Lang } from "../../../lib/i18n";

export const getStaticPaths = langPaths;

interface Props {
  lang: Lang;
  /** Injected by the component tests; the page itself always shows the extracted data. */
  data?: GuidesData;
}

const { lang } = Astro.props;
const data = Astro.props.data ?? guidesData;
const guide = guideBySlug("enchanting") as GuideLink;
const points = textOf(data, "enchantmentPoints", lang);
const shards = textOf(data, "echoShards", lang);
const pointsName = { html: points?.html ?? "" };
const shardsName = { html: shards?.html ?? "" };
const perLevel = (name: { html: string }) => fill(t(lang, "guideColPerLevel"), { name });
const enchantsmith = data.vendors.find((vendor) => vendor.id === "enchantsmith");
const upgrades = (enchantsmith?.levels ?? []).map((level) => ({ ...level, unlock: unlockText(data, "enchantsmith", level.level, lang) }));
---
<GuidePage lang={lang} guide={guide}>
  {data.enchanting.costs.length > 0 && (
    <section class="entry-section guide-section" data-testid="guide-enchant-costs">
      <h2 class="section-title">{t(lang, "guideEnchantCosts")}</h2>
      <GuideMarker lang={lang} texts={[points, shards]} />
      <GuideUnconfirmed lang={lang} message="guideEnchantScalingUnconfirmed" verified={data.verified.enchantCostPerLevel} />
      <div class="guide-scroll" tabindex="0" role="region" aria-label={t(lang, "guideEnchantCosts")}>
        <table class="guide-table">
          <thead>
            <tr>
              <th scope="col">{t(lang, "rarity")}</th>
              <th scope="col" set:html={pointsName.html} />
              <th scope="col" set:html={perLevel(pointsName)} />
              <th scope="col" set:html={shardsName.html} />
              <th scope="col" set:html={perLevel(shardsName)} />
            </tr>
          </thead>
          <tbody>
            {data.enchanting.costs.map((cost) => (
              <tr>
                <th scope="row">{rarityName(cost.rarity, lang)}</th>
                <td class="guide-number">{formatNumber(cost.points, lang)}</td>
                <td class="guide-number">+{formatNumber(cost.pointsPerLevel, lang)}</td>
                <td class="guide-number">{formatNumber(cost.shards, lang)}</td>
                <td class="guide-number">+{formatNumber(cost.shardsPerLevel, lang)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}
  <section class="entry-section guide-section" data-testid="guide-enchant-points">
    <GuideHeading lang={lang} text={points} />
    <GuideText lang={lang} text={textOf(data, "enchantmentPointsTutorial", lang)} />
  </section>
  <section class="entry-section guide-section" data-testid="guide-enchantsmith">
    <GuideHeading lang={lang} text={textOf(data, "enchantsmithName", lang)} />
    <GuideText lang={lang} text={textOf(data, "enchantsmithTutorial", lang)} />
    <h3 class="guide-subtitle">{t(lang, "guideUpgradeEnchantments")}</h3>
    <GuideMarker lang={lang} texts={upgrades.map((level) => level.unlock)} />
    {/* One row per Enchantsmith level: what it costs in Echo Shards and the upgrade it unlocks (the game's own unlock line). */}
    {upgrades.length > 0 && (
      <div class="guide-scroll" tabindex="0" role="region" aria-label={t(lang, "guideUpgradeEnchantments")}>
        <table class="guide-table" data-testid="guide-enchant-upgrades">
          <thead><tr><th scope="col">{t(lang, "guideColLevel")}</th><th scope="col">{shards ? <span set:html={shards.html} /> : t(lang, "guideColCost")}</th><th scope="col">{t(lang, "guideColUnlocks")}</th></tr></thead>
          <tbody>
            {upgrades.map((level) => (
              <tr>
                <th scope="row">{level.level}</th>
                <td class="guide-number">{formatNumber(level.cost, lang)}</td>
                <td class="guide-cell-text">{level.unlock && <span set:html={level.unlock.html} />}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>
</GuidePage>
