---
import { LANGS } from "../../../scripts/extract/config";
import Base from "../../layouts/Base.astro";
import { t, type Lang } from "../../lib/i18n";
import { assetUrl, href } from "../../lib/url";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const placeholder = t(lang, "search");
const unavailable = t(lang, "searchUnavailable");
const SKELETON_ROWS = 3;
---
<Base lang={lang} title={t(lang, "search")} noindex>
  <link rel="stylesheet" href={assetUrl("pagefind/pagefind-ui.css")} />
  <div class="search-page">
    <h1>{t(lang, "search")}</h1>
    {/* Works without scripts; Pagefind replaces it once it is up, and it stays if Pagefind cannot start. */}
    <div class="search-fallback" id="search-fallback" data-state="loading">
      <form class="search-form" action={href(lang, "search")} method="get" role="search">
        <input type="search" name="q" placeholder={t(lang, "searchPlaceholder")} aria-label={placeholder} />
        <button type="submit">{placeholder}</button>
      </form>
      <ol class="search-skeleton" aria-hidden="true">
        {Array.from({ length: SKELETON_ROWS }, () => <li class="search-skeleton-row"><span class="search-skeleton-thumb"></span><span class="search-skeleton-lines"></span></li>)}
      </ol>
      <p class="search-error" role="status">{unavailable}</p>
    </div>
    <div id="search" data-testid="search"></div>
  </div>
  <script is:inline src={assetUrl("pagefind/pagefind-ui.js")}></script>
  <script is:inline define:vars={{ base, placeholder }}>
    window.addEventListener("DOMContentLoaded", () => {
      const fallback = document.getElementById("search-fallback");
      try {
        const ui = new PagefindUI({
          element: "#search",
          baseUrl: base,
          showSubResults: true,
          showImages: true,
          translations: { placeholder },
        });
        fallback?.remove();
        document.querySelector("#search .pagefind-ui__search-input")?.setAttribute("aria-label", placeholder);
        const query = new URLSearchParams(window.location.search).get("q");
        if (query) ui.triggerSearch(query);
      } catch (error) {
        // PagefindUI is undefined (script missing) or failed to start: keep the plain form and say so.
        console.error("Pagefind failed to start", error);
        if (fallback) fallback.dataset.state = "error";
      }
    });
  </script>
</Base>
