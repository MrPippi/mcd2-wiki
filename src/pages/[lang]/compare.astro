---
import { langPaths } from "../../lib/lang-paths";
import WeaponCompare from "../../components/WeaponCompare.astro";
import CatalogPage from "../../layouts/CatalogPage.astro";
import { comparePayload } from "../../lib/compare/payload";
import { t, type Lang } from "../../lib/i18n";
import "../../styles/compare.css";

export const getStaticPaths = langPaths;

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---
<CatalogPage lang={lang} label={(l) => t(l, "weaponCompare")} intro={t(lang, "weaponCompareIntro")} introClass="compare-intro" class="compare-page" headClass="compare-head" pagefindBody>
    <noscript><p class="note" data-testid="compare-noscript">{t(lang, "weaponCompareNoScript")}</p></noscript>
    <WeaponCompare lang={lang} payload={comparePayload(lang)} />
</CatalogPage>
