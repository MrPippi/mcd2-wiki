---
import { LANGS } from "../../../scripts/extract/config";
import WeaponCompare from "../../components/WeaponCompare.astro";
import Base from "../../layouts/Base.astro";
import { comparePayload } from "../../lib/compare/payload";
import { t, type Lang } from "../../lib/i18n";
import { compareLang, htmlLang } from "../../lib/lang";
import "../../styles/compare.css";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const alt = compareLang(lang);
---
<Base lang={lang} title={t(lang, "weaponCompare")} description={t(lang, "weaponCompareIntro")}>
  <div class="catalog compare-page" data-pagefind-body>
    <header class="catalog-head compare-head">
      <h1 class="catalog-title"><span data-pagefind-meta="title">{t(lang, "weaponCompare")}</span></h1>
      {t(alt, "weaponCompare") !== t(lang, "weaponCompare") && <p class="catalog-alt item-alt" lang={htmlLang(alt)}>{t(alt, "weaponCompare")}</p>}
      <p class="compare-intro">{t(lang, "weaponCompareIntro")}</p>
    </header>
    <noscript><p class="note" data-testid="compare-noscript">{t(lang, "weaponCompareNoScript")}</p></noscript>
    <WeaponCompare lang={lang} payload={comparePayload(lang)} />
  </div>
</Base>
