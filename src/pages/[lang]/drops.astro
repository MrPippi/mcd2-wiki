---
import { langPaths } from "../../lib/lang-paths";
import DropCalculator from "../../components/DropCalculator.astro";
import GuideUnconfirmed from "../../components/GuideUnconfirmed.astro";
import CatalogPage from "../../layouts/CatalogPage.astro";
import { calcPayload } from "../../lib/drop-calc/payload";
import { guidesData } from "../../lib/guides";
import { t, type Lang } from "../../lib/i18n";
import "../../styles/compare.css";
import "../../styles/drops.css";

export const getStaticPaths = langPaths;

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const payload = calcPayload(lang);
---
<CatalogPage lang={lang} label={(l) => t(l, "dropCalc")} intro={t(lang, "dropCalcIntro")} introClass="compare-intro" class="compare-page drops-page" headClass="compare-head" pagefindBody>
    <div class="drops-body">
    <noscript><p class="note" data-testid="drop-noscript">{t(lang, "dropCalcNoScript")}</p></noscript>
    <p class="note">{t(lang, "dropOddsIntro")}</p>
    <p class="note">{t(lang, "dropCalcCoverage")}</p>
    <p class="note" data-testid="drop-not-included">{t(lang, "dropNotIncluded")}</p>
    <GuideUnconfirmed lang={lang} message="dropOddsUnconfirmed" verified={guidesData.verified.dropOdds} />
    {payload.available
      ? <DropCalculator lang={lang} payload={payload} />
      : <p class="note" data-testid="drop-no-data">{t(lang, "dropCalcNoData")}</p>}
    </div>
</CatalogPage>
