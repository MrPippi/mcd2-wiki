---
import { LANGS } from "../../../../scripts/extract/config";
import type { QuestData } from "../../../../scripts/extract/quest-schema";
import QuestCard from "../../../components/QuestCard.astro";
import Base from "../../../layouts/Base.astro";
import { t, type Lang } from "../../../lib/i18n";
import { compareLang, htmlLang } from "../../../lib/lang";
import { questSections, SECTION_KEY } from "../../../lib/quest-view";
import { questData } from "../../../lib/quests";
import "../../../styles/quests.css";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Lang;
  /** Injected by the component tests; the page itself always shows the extracted data. */
  data?: QuestData;
}

const { lang } = Astro.props;
const data = Astro.props.data ?? questData;
const alt = compareLang(lang);
const sections = questSections(data.quests);
// Cards stagger their entrance across the whole list, like one printed catalogue.
const offsets = sections.map((_, i) => sections.slice(0, i).reduce((sum, section) => sum + section.count, 0));
---
<Base lang={lang} title={t(lang, "quests")} description={t(lang, "questsIntro")}>
  <div class="catalog quests-page" data-pagefind-body>
    <header class="catalog-head quests-head">
      <p class="catalog-count kicker mono">{data.quests.length}</p>
      <h1 class="catalog-title">
        <span data-pagefind-meta="title">{t(lang, "quests")}</span>
      </h1>
      {t(alt, "quests") !== t(lang, "quests") && <p class="catalog-alt item-alt" lang={htmlLang(alt)}>{t(alt, "quests")}</p>}
      <p class="quests-intro">{t(lang, "questsIntro")}</p>
    </header>
    <div class="quest-sections">
      {sections.map((section, s) => (
        <section class="quest-section" data-section={section.section} data-testid={`quest-section-${section.section}`}>
          <h2 class="section-title" data-pagefind-ignore>
            <span>{t(lang, SECTION_KEY[section.section])}</span> <span class="count">({section.count})</span>
          </h2>
          {section.groups.map((group, g) => {
            const before = section.groups.slice(0, g).reduce((sum, one) => sum + one.quests.length, 0);
            return (
              <div class="quest-group">
                {group.region && <h3 class="quest-region" data-testid="quest-region">{group.region.name[lang]}</h3>}
                <ol class="quest-grid">
                  {group.quests.map((quest, i) => (
                    <QuestCard lang={lang} quest={quest} index={offsets[s] + before + i} step={section.section === "core" ? before + i + 1 : undefined} />
                  ))}
                </ol>
              </div>
            );
          })}
        </section>
      ))}
    </div>
  </div>
</Base>
