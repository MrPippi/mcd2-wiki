---
import { LANGS } from "../../../../scripts/extract/config";
import WorldMap from "../../../components/WorldMap.astro";
import Base from "../../../layouts/Base.astro";
import { t, type Lang } from "../../../lib/i18n";
import { mapData } from "../../../lib/map/data";
import "../../../styles/map.css";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---
<Base lang={lang} title={t(lang, "worldMap")} description={t(lang, "mapIntro")}>
  <div class="map-page">
    <h1>{t(lang, "worldMap")}</h1>
    <p class="map-intro">{t(lang, "mapIntro")}</p>
    <WorldMap lang={lang} worlds={mapData.worlds} legend={mapData.legend} />
  </div>
</Base>
