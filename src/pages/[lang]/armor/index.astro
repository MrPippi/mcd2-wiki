---
import { langPaths } from "../../../lib/lang-paths";
import { ARMOR_PIECES } from "../../../../shared/schemas";
import ItemBrowser from "../../../components/ItemBrowser.astro";
import ListFilter from "../../../components/ListFilter.astro";
import ItemCard from "../../../components/ItemCard.astro";
import CatalogPage from "../../../layouts/CatalogPage.astro";
import { allArmorSets, findEntry } from "../../../lib/data";
import { categoryLabel, pieceLabel, t, type Lang } from "../../../lib/i18n";
import { setKicker } from "../../../lib/kicker";
import { categoryIcon } from "../../../lib/ui-icons";
import { href } from "../../../lib/url";

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const cards = allArmorSets.map((set) => {
  const pieces = ARMOR_PIECES.flatMap((piece) => {
    const slug = set.pieces[piece];
    const entry = slug ? findEntry("armor", slug) : undefined;
    return entry ? [{ piece, entry }] : [];
  });
  return { set, pieces, icon: pieces[0]?.entry.icon };
});
---
<CatalogPage lang={lang} label={(l) => categoryLabel("armor", l)} count={cards.length} icon={categoryIcon("armor")} current="armor">
  <ListFilter slot="head" lang={lang} showVariant={true} />
  <p class="no-results" hidden>{t(lang, "noResults")}</p>
  <ItemBrowser lang={lang}>
    {cards.map(({ set, pieces, icon }, index) => (
      <ItemCard
        lang={lang}
        index={index}
        href={href(lang, "armor", set.slug)}
        name={set.name}
        icon={icon}
        category="armor"
        variant={set.variant}
        kicker={setKicker(set.variant)}
      >
        <ul class="tooltip-pieces">
          {pieces.map(({ piece, entry }) => <li>{pieceLabel(piece, lang)}{t(lang, "labelColon")}{entry.name[lang]}</li>)}
        </ul>
      </ItemCard>
    ))}
  </ItemBrowser>
</CatalogPage>
