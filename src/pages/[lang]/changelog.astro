---
import { langPaths } from "../../lib/lang-paths";
import CatalogPage from "../../layouts/CatalogPage.astro";
import { CHANGE_KIND_KEY, changeText, changelog, changelogDate } from "../../lib/changelog";
import { t, type Lang } from "../../lib/i18n";
import { href } from "../../lib/url";
import { htmlLang } from "../../../shared/lang";
import "../../styles/changelog.css";

export const getStaticPaths = langPaths;

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---
<CatalogPage lang={lang} label={(l) => t(l, "changelog")} intro={t(lang, "changelogIntro")} introClass="changelog-intro" class="changelog-page" pagefindBody>
  <ol class="changelog-list" data-testid="changelog">
    {changelog.map((entry, index) => (
      <li class="changelog-entry" id={entry.date} style={`--i: ${index}`}>
        <h2 class="changelog-date"><time datetime={entry.date}>{changelogDate(entry.date, lang)}</time></h2>
        <ul class="changelog-changes">
          {entry.changes.map((change) => {
            const { text, lang: textLang } = changeText(change, lang);
            return (
              <li class="changelog-change" data-kind={change.kind}>
                <span class:list={["changelog-kind", `is-${change.kind}`]}>{t(lang, CHANGE_KIND_KEY[change.kind])}</span>
                <span class="changelog-text" lang={textLang === lang ? undefined : htmlLang(textLang)}>
                  {change.link ? <a href={href(lang, ...change.link.split("/"))}>{text}</a> : text}
                </span>
              </li>
            );
          })}
        </ul>
      </li>
    ))}
  </ol>
</CatalogPage>
