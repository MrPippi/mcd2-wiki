---
import { langPaths } from "../../../lib/lang-paths";
import type { LocationData } from "../../../../shared/location-schema";
import LocationCard from "../../../components/LocationCard.astro";
import CatalogPage from "../../../layouts/CatalogPage.astro";
import { t, type Lang } from "../../../lib/i18n";
import { locationData } from "../../../lib/locations";
import "../../../styles/locations.css";

export const getStaticPaths = langPaths;

interface Props {
  lang: Lang;
  /** Injected by the component tests; the page itself always shows the extracted data. */
  data?: LocationData;
}

const { lang } = Astro.props;
const data = Astro.props.data ?? locationData;
---
<CatalogPage lang={lang} label={(l) => t(l, "locations")} count={data.locations.length} intro={t(lang, "locationsIntro")} introClass="locations-intro" class="locations-page" headClass="locations-head" pagefindBody>
    <ol class="location-grid" data-testid="location-grid">
      {data.locations.map((location, index) => <LocationCard lang={lang} location={location} index={index} />)}
    </ol>
</CatalogPage>
