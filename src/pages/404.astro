---
import Base from "../layouts/Base.astro";
import { t } from "../lib/i18n";
import { href } from "../lib/url";

// One 404 serves both languages: Chinese first, with the English line under it.
const lang = "zh";
---
<Base lang={lang} title={t(lang, "notFoundTitle")} langSwitchHref={href("en")}>
  <section class="not-found">
    <div class="not-found-copy">
      <p class="kicker">ERROR 404 · SLOT EMPTY</p>
      <h1 class="lang-text">
        <span class="primary">{t("zh", "notFoundTitle")}</span>
        <span class="alt" lang="en">{t("en", "notFoundTitle")}</span>
      </h1>
      <p>{t("zh", "notFoundBody")}</p>
      <p class="note" lang="en">{t("en", "notFoundBody")}</p>
      <form class="home-search" action={href("zh", "search")} method="get" role="search">
        <input type="search" name="q" placeholder={t("zh", "searchPlaceholder")} aria-label={t("zh", "search")} />
        <button type="submit">{t("zh", "search")}</button>
      </form>
      <p class="not-found-links">
        <a href={href("zh")}>{t("zh", "backHome")} ›</a>
        <a href={href("en")} lang="en">{t("en", "backHome")} ›</a>
      </p>
    </div>
    <div class="not-found-slot" aria-hidden="true"><span>?</span></div>
  </section>
</Base>
<style>
  .not-found {
    display: grid; grid-template-columns: 1fr; gap: 32px; align-items: center; padding: 24px 0 16px;
  }
  .not-found-copy p { max-width: 52ch; }
  .not-found-links { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 24px; }
  .not-found-slot {
    order: -1; width: 128px; height: 128px; display: flex; align-items: center; justify-content: center;
    border: 3px dashed var(--border-strong); color: var(--border-strong);
    font-family: var(--font-pixel); font-size: var(--fs-pixel-2xl);
  }
  .not-found-slot span { animation: breathe 2.4s ease-in-out infinite; }
  @media (min-width: 900px) {
    .not-found { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); min-height: 420px; }
    .not-found-slot { order: 0; width: 200px; height: 200px; justify-self: center; font-size: 96px; }
  }
</style>
