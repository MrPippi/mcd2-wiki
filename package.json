{
  "name": "mcd2-wiki",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "extract": "tsx scripts/extract/index.ts",
    "assets": "tsx scripts/assets/index.ts",
    "tiles": "tsx scripts/map-tiles/index.ts",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview --port 4329",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.0",
    "@fontsource/noto-serif-kr": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@fontsource/noto-serif-tc": "^5.3.0",
    "astro": "^7.3.8",
    "leaflet": "^1.9.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
